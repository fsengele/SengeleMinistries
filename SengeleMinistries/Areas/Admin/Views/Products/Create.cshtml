
@model SengeleMinistries.Models.Product

@{
    ViewData["Title"] = "Create New Product";
}

<section class="admin-product-form-page">
    <div class="admin-product-form-container">

        <div class="admin-product-form-header">
            <p class="admin-eyebrow">
                SENGELE MINISTRIES ADMIN
            </p>

            <h1>Create New Product</h1>

            <p class="admin-form-subtitle">
                Add a new product to the Sengele Ministries Shop.
            </p>
        </div>

        <div class="admin-product-card">

            @* Simple ASP.NET Core MVC form *@
            <form method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                @* =========================
                   PRODUCT TYPE
                   ========================= *@
                <div class="admin-form-group">

                    <label asp-for="ProductType"
                           class="form-label">
                        Product Type
                    </label>

                    <select asp-for="ProductType"
                            class="form-control"
                            id="productType">

                        <option value="OwnProduct">
                            Sengele Ministries Product
                        </option>

                        <option value="AmazonAffiliate">
                            Amazon Affiliate Product
                        </option>

                    </select>

                    <span asp-validation-for="ProductType"
                          class="text-danger">
                    </span>

                </div>

                @* =========================
                   TITLE
                   ========================= *@
                <div class="admin-form-group">

                    <label asp-for="Title"
                           class="form-label">
                    </label>

                    <input asp-for="Title"
                           class="form-control" />

                    <span asp-validation-for="Title"
                          class="text-danger">
                    </span>

                </div>

                @* =========================
                   CATEGORY
                   ========================= *@
                <div class="admin-form-group">

                    <label asp-for="Category"
                           class="form-label">
                    </label>

                    <select asp-for="Category"
                            class="form-control">

                        <option value="">
                            Select a category
                        </option>

                        <option value="Books">
                            Books &amp; Bibles
                        </option>

                        <option value="Teachings">
                            Teachings &amp; Resources
                        </option>

                        <option value="EventCollections">
                            Event Collections
                        </option>

                        <option value="Apparel">
                            Apparel
                        </option>

                        <option value="Electronics">
                            Electronics
                        </option>

                        <option value="Other">
                            Other
                        </option>

                    </select>

                    <span asp-validation-for="Category"
                          class="text-danger">
                    </span>

                </div>

                @* =========================
                   SHORT DESCRIPTION
                   ========================= *@
                <div class="admin-form-group">

                    <label asp-for="ShortDescription"
                           class="form-label">
                        Short Description
                    </label>

                    <input asp-for="ShortDescription"
                           class="form-control" />

                    <span asp-validation-for="ShortDescription"
                          class="text-danger">
                    </span>

                </div>

                @* =========================
                   FULL DESCRIPTION
                   ========================= *@
                <div class="admin-form-group">

                    <label asp-for="Description"
                           class="form-label">
                        Full Description
                    </label>

                    <textarea asp-for="Description"
                              class="form-control"
                              rows="6"></textarea>

                    <span asp-validation-for="Description"
                          class="text-danger">
                    </span>

                </div>

                @* =========================
                   AMAZON AFFILIATE LINK
                   ========================= *@
                <div class="admin-form-group"
                     id="amazonLinkSection"
                     style="display:none;">

                    <label asp-for="AffiliateUrl"
                           class="form-label">
                        Amazon Affiliate Link
                    </label>

                    <input asp-for="AffiliateUrl"
                           class="form-control"
                           type="url"
                           placeholder="https://link.amazon/..." />

                    <span asp-validation-for="AffiliateUrl"
                          class="text-danger">
                    </span>

                    <p class="admin-form-note">
                        Paste your Amazon Associates affiliate link here.
                    </p>

                </div>

                @* =========================
                   PRICE + STOCK
                   ========================= *@
                <div class="admin-form-row"
                     id="ownProductSection">

                    <div class="admin-form-group">

                        <label asp-for="Price"
                               class="form-label">
                        </label>

                        <input asp-for="Price"
                               class="form-control" />

                        <span asp-validation-for="Price"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="admin-form-group">

                        <label asp-for="StockQuantity"
                               class="form-label">
                            Stock Quantity
                        </label>

                        <input asp-for="StockQuantity"
                               class="form-control"
                               type="number"
                               min="0" />

                        <span asp-validation-for="StockQuantity"
                              class="text-danger">
                        </span>

                    </div>

                </div>

                @* =========================
                   IMAGE
                   ========================= *@
                <div class="admin-form-group">

                    <label asp-for="ImageUrl"
                           class="form-label">
                        Image URL
                    </label>

                    <input asp-for="ImageUrl"
                           class="form-control"
                           placeholder="https://..." />

                    <span asp-validation-for="ImageUrl"
                          class="text-danger">
                    </span>

                    <p class="admin-form-note"
                       id="amazonImageNote"
                       style="display:none;">
                        Use an image you are authorized to display.
                        Amazon images are not automatically imported yet.
                    </p>

                </div>

                @* =========================
                   PUBLISH
                   ========================= *@
                <div class="admin-publish-box">

                    <input asp-for="IsPublished"
                           class="form-check-input" />

                    <label asp-for="IsPublished"
                           class="form-check-label">
                        Publish this product
                    </label>

                </div>

                <p class="admin-form-note"
                   id="ownProductNote">
                    Published Sengele Ministries products
                    will appear in the public Shop
                    and can be added to the shopping cart.
                </p>

                <p class="admin-form-note"
                   id="amazonProductNote"
                   style="display:none;">
                    Amazon affiliate products will redirect
                    customers to Amazon for purchasing.
                    As an Amazon Associate, I earn from
                    qualifying purchases.
                </p>

                @* =========================
                   BUTTONS
                   ========================= *@
                <div class="admin-form-actions">

                    <input type="submit"
                           value="Create Product"
                           class="admin-save-btn" />

                    <a asp-area="Admin"
                       asp-controller="Products"
                       asp-action="Index"
                       class="admin-cancel-btn">
                        Cancel
                    </a>

                </div>

            </form>

        </div>

    </div>
</section>

@section Scripts {

    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial");
    }

    <script>
        // Show fields based on the selected product type.
        document.addEventListener("DOMContentLoaded", function () {

            const productType =
                document.getElementById("productType");

            const amazonLinkSection =
                document.getElementById("amazonLinkSection");

            const ownProductSection =
                document.getElementById("ownProductSection");

            const amazonImageNote =
                document.getElementById("amazonImageNote");

            const ownProductNote =
                document.getElementById("ownProductNote");

            const amazonProductNote =
                document.getElementById("amazonProductNote");

            const affiliateInput =
                document.getElementById("AffiliateUrl");

            function updateProductFields() {

                const isAmazon =
                    productType.value === "AmazonAffiliate";

                amazonLinkSection.style.display =
                    isAmazon ? "block" : "none";

                ownProductSection.style.display =
                    isAmazon ? "none" : "flex";

                amazonImageNote.style.display =
                    isAmazon ? "block" : "none";

                ownProductNote.style.display =
                    isAmazon ? "none" : "block";

                amazonProductNote.style.display =
                    isAmazon ? "block" : "none";

                affiliateInput.required = isAmazon;

                if (!isAmazon) {
                    affiliateInput.value = "";
                }
            }

            productType.addEventListener(
                "change", updateProductFields);

            updateProductFields();
        });
    </script>
}
