@model SengeleMinistries.Models.Product

@{
    ViewData["Title"] = "Delete Product";
}

<section class="admin-product-form-page">
    <div class="admin-product-form-container">

        <div class="admin-product-form-header">

            <p class="admin-eyebrow">
                SENGELE MINISTRIES ADMIN
            </p>

            <h1>Delete Product</h1>

            <p class="admin-form-subtitle">
                Please confirm that you want to delete this product.
            </p>

        </div>

        <div class="admin-product-card">

            <div class="admin-form-group">
                <label>Product</label>
                <p>
                    <strong>@Model.Title</strong>
                </p>
            </div>

            <div class="admin-form-group">
                <label>Category</label>
                <p>@Model.Category</p>
            </div>

            <div class="admin-form-group">
                <label>Price</label>
                <p>@Model.Price.ToString("C")</p>
            </div>

            <div class="admin-form-group">
                <label>Stock Quantity</label>
                <p>
                    @(Model.StockQuantity?.ToString() ?? "Not specified")
                </p>
            </div>

            <div class="admin-form-group">
                <label>Status</label>

                @if (Model.IsPublished)
                {
                    <p>Published</p>
                }
                else
                {
                    <p>Draft</p>
                }
            </div>

            <div class="alert alert-danger mt-4">
                <strong>Warning:</strong>
                This action cannot be undone.
            </div>

            <form method="post">

                <input asp-for="ProductId"
                       type="hidden" />

                <div class="admin-form-actions">

                    <input type="submit"
                           value="Delete Product"
                           class="btn btn-danger" />

                    <a asp-area="Admin"
                       asp-controller="Products"
                       asp-action="Index"
                       class="admin-cancel-btn">
                        Cancel
                    </a>

                </div>

            </form>

        </div>

    </div>
</section>