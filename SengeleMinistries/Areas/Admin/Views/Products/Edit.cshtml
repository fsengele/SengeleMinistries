
@model SengeleMinistries.Models.Product

@{
    ViewData["Title"] = "Update Product";
}

<section class="admin-product-form-page">
    <div class="admin-product-form-container">

        <div class="admin-product-form-header">
            <p class="admin-eyebrow">
                SENGELE MINISTRIES ADMIN
            </p>

            <h1>Update Product</h1>

            <p class="admin-form-subtitle">
                Update the product information below.
            </p>
        </div>

        <div class="admin-product-card">

            <form method="post">

                @Html.AntiForgeryToken()

                <input asp-for="ProductId" type="hidden" />

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                @* =========================
                   PRODUCT TYPE
                   ========================= *@
                <div class="admin-form-group">

                    <label asp-for="ProductType"
                           class="form-label">
                        Product Type
                    </label>

                    <select asp-for="ProductType"
                            class="form-control"
                            id="productType">

                        <option value="OwnProduct">
                            Sengele Ministries Product
                        </option>

                        <option value="AmazonAffiliate">
                            Amazon Affiliate Product
                        </option>

                    </select>

                    <span asp-validation-for="ProductType"
                          class="text-danger">
                    </span>

                </div>

                @* =========================
                   TITLE
                   ========================= *@
                <div class="admin-form-group">

                    <label asp-for="Title"
                           class="form-label">
                    </label>

                    <input asp-for="Title"
                           class="form-control" />

                    <span asp-validation-for="Title"
                          class="text-danger">
                    </span>

                </div>

                @* =========================
                   CATEGORY
                   ========================= *@
                <div class="admin-form-group">

                    <label asp-for="Category"
                           class="form-label">
                    </label>

                    <select asp-for="Category"
                            class="form-control">

                        <option value="">
                            Select a category
                        </option>

                        <option value="Books">
                            Books &amp; Bibles
                        </option>

                        <option value="Teachings">
                            Teachings &amp; Resources
                        </option>

                        <option value="EventCollections">
                            Event Collections
                        </option>

                        <option value="Apparel">
                            Apparel
                        </option>

                        <option value="Electronics">
                            Electronics
                        </option>

                        <option value="Other">
                            Other
                        </option>

                    </select>

                    <span asp-validation-for="Category"
                          class="text-danger">
                    </span>

                </div>

                @* =========================
                   SHORT DESCRIPTION
                   ========================= *@
                <div class="admin-form-group">

                    <label asp-for="ShortDescription"
                           class="form-label">
                        Short Description
                    </label>

                    <input asp-for="ShortDescription"
                           class="form-control" />

                    <span asp-validation-for="ShortDescription"
                          class="text-danger">
                    </span>

                </div>

                @* =========================
                   FULL DESCRIPTION
                   ========================= *@
                <div class="admin-form-group">

                    <label asp-for="Description"
                           class="form-label">
                        Full Description
                    </label>

                    <textarea asp-for="Description"
                              class="form-control"
                              rows="6"></textarea>

                    <span asp-validation-for="Description"
                          class="text-danger">
                    </span>

                </div>

                @* =========================
                   AMAZON AFFILIATE LINK
                   ========================= *@
                <div class="admin-form-group"
                     id="amazonLinkSection"
                     style="display:none;">

                    <label asp-for="AffiliateUrl"
                           class="form-label">
                        Amazon Affiliate Link
                    </label>

                    <input asp-for="AffiliateUrl"
                           class="form-control"
                           type="url"
                           placeholder="https://link.amazon/..." />

                    <span asp-validation-for="AffiliateUrl"
                          class="text-danger">
                    </span>

                    <p class="admin-form-note">
                        Paste your Amazon Associates affiliate link here.
                    </p>

                </div>

                @* =========================
                   PRICE + STOCK
                   ========================= *@
                <div class="admin-form-row"
                     id="ownProductSection">

                    <div class="admin-form-group">

                        <label asp-for="Price"
                               class="form-label">
                        </label>

                        <input asp-for="Price"
                               class="form-control" />

                        <span asp-validation-for="Price"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="admin-form-group">

                        <label asp-for="StockQuantity"
                               class="form-label">
                            Stock Quantity
                        </label>

                        <input asp-for="StockQuantity"
                               class="form-control"
                               type="number"
                               min="0" />

                        <span asp-validation-for="StockQuantity"
                              class="text-danger">
                        </span>

                    </div>

                </div>

                @* ==========================================
                   SHIPPING INFORMATION
                   ========================================== *@
                <div id="shippingSection">

                    <hr class="my-4" />

                    <h3 class="mb-3">
                        Shipping Information
                    </h3>

                    <div class="admin-form-group">

                        <label asp-for="RequiresShipping"
                               class="form-label">
                            Product Delivery Type
                        </label>

                        <select asp-for="RequiresShipping"
                                class="form-control"
                                id="requiresShipping">

                            <option value="true">
                                Physical Product - Requires Shipping
                            </option>

                            <option value="false">
                                Digital Product - No Shipping
                            </option>

                        </select>

                        <span asp-validation-for="RequiresShipping"
                              class="text-danger">
                        </span>

                        <p class="admin-form-note">
                            Select Physical Product for items
                            shipped to customers.
                            Select Digital Product for items
                            delivered electronically.
                        </p>

                    </div>

                    <div id="shippingDimensionsSection">

                        <h4 class="mb-3">
                            Product Weight and Dimensions
                        </h4>

                        <p class="admin-form-note">
                            These measurements can be used
                            when shipping calculations
                            are configured.
                        </p>

                        <div class="admin-form-row">

                            <div class="admin-form-group">

                                <label asp-for="WeightOz"
                                       class="form-label">
                                    Weight (oz)
                                </label>

                                <input asp-for="WeightOz"
                                       class="form-control"
                                       type="number"
                                       min="0.01"
                                       step="0.01"
                                       placeholder="Example: 16" />

                                <span asp-validation-for="WeightOz"
                                      class="text-danger">
                                </span>

                            </div>

                            <div class="admin-form-group">

                                <label asp-for="LengthIn"
                                       class="form-label">
                                    Length (inches)
                                </label>

                                <input asp-for="LengthIn"
                                       class="form-control"
                                       type="number"
                                       min="0.01"
                                       step="0.01"
                                       placeholder="Example: 10" />

                                <span asp-validation-for="LengthIn"
                                      class="text-danger">
                                </span>

                            </div>

                        </div>

                        <div class="admin-form-row">

                            <div class="admin-form-group">

                                <label asp-for="WidthIn"
                                       class="form-label">
                                    Width (inches)
                                </label>

                                <input asp-for="WidthIn"
                                       class="form-control"
                                       type="number"
                                       min="0.01"
                                       step="0.01"
                                       placeholder="Example: 8" />

                                <span asp-validation-for="WidthIn"
                                      class="text-danger">
                                </span>

                            </div>

                            <div class="admin-form-group">

                                <label asp-for="HeightIn"
                                       class="form-label">
                                    Height (inches)
                                </label>

                                <input asp-for="HeightIn"
                                       class="form-control"
                                       type="number"
                                       min="0.01"
                                       step="0.01"
                                       placeholder="Example: 3" />

                                <span asp-validation-for="HeightIn"
                                      class="text-danger">
                                </span>

                            </div>

                        </div>

                        <p class="admin-form-note">
                            Measurements are optional while
                            shipping setup is being prepared.
                        </p>

                    </div>

                </div>

                @* =========================
                   PRODUCT IMAGES
                   ========================= *@
                <div class="admin-form-group">

                    <label asp-for="ImageUrl"
                           class="form-label">
                        Image 1 URL - Main Photo
                    </label>

                    <input asp-for="ImageUrl"
                           class="form-control"
                           type="text"
                           placeholder="/images/product.jpg or https://..." />

                    <span asp-validation-for="ImageUrl"
                          class="text-danger">
                    </span>

                </div>

                <div class="admin-form-group">

                    <label asp-for="ImageUrl2"
                           class="form-label">
                        Image 2 URL
                    </label>

                    <input asp-for="ImageUrl2"
                           class="form-control"
                           type="text"
                           placeholder="/images/product2.jpg or https://..." />

                    <span asp-validation-for="ImageUrl2"
                          class="text-danger">
                    </span>

                </div>

                <div class="admin-form-group">

                    <label asp-for="ImageUrl3"
                           class="form-label">
                        Image 3 URL
                    </label>

                    <input asp-for="ImageUrl3"
                           class="form-control"
                           type="text"
                           placeholder="/images/product3.jpg or https://..." />

                    <span asp-validation-for="ImageUrl3"
                          class="text-danger">
                    </span>

                </div>

                <div class="admin-form-group">

                    <label asp-for="ImageUrl4"
                           class="form-label">
                        Image 4 URL
                    </label>

                    <input asp-for="ImageUrl4"
                           class="form-control"
                           type="text"
                           placeholder="/images/product4.jpg or https://..." />

                    <span asp-validation-for="ImageUrl4"
                          class="text-danger">
                    </span>

                    <p class="admin-form-note">
                        Add up to four product images.
                        Use local image paths beginning with
                        /images/ or full HTTPS image URLs.
                    </p>

                    <p class="admin-form-note"
                       id="amazonImageNote"
                       style="display:none;">
                        Use images you are authorized to display.
                        Amazon images are not automatically imported.
                    </p>

                </div>

                @* =========================
                   PUBLISH
                   ========================= *@
                <div class="admin-publish-box">

                    <input asp-for="IsPublished"
                           class="form-check-input" />

                    <label asp-for="IsPublished"
                           class="form-check-label">
                        Publish this product
                    </label>

                </div>

                <p class="admin-form-note"
                   id="ownProductNote">
                    Published Sengele Ministries products
                    appear in the public Shop
                    and can be added to the shopping cart.
                </p>

                <p class="admin-form-note"
                   id="amazonProductNote"
                   style="display:none;">
                    Amazon affiliate products will redirect
                    customers to Amazon for purchasing.
                    As an Amazon Associate, I earn from
                    qualifying purchases.
                </p>

                @* =========================
                   BUTTONS
                   ========================= *@
                <div class="admin-form-actions">

                    <input type="submit"
                           value="Update Product"
                           class="admin-save-btn" />

                    <a asp-area="Admin"
                       asp-controller="Products"
                       asp-action="Index"
                       class="admin-cancel-btn">
                        Cancel
                    </a>

                </div>

            </form>

        </div>

    </div>
</section>

@section Scripts {

    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial");
    }

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const productType =
                document.getElementById("productType");

            const amazonLinkSection =
                document.getElementById("amazonLinkSection");

            const ownProductSection =
                document.getElementById("ownProductSection");

            const shippingSection =
                document.getElementById("shippingSection");

            const requiresShipping =
                document.getElementById("requiresShipping");

            const shippingDimensionsSection =
                document.getElementById("shippingDimensionsSection");

            const amazonImageNote =
                document.getElementById("amazonImageNote");

            const ownProductNote =
                document.getElementById("ownProductNote");

            const amazonProductNote =
                document.getElementById("amazonProductNote");

            const affiliateInput =
                document.getElementById("AffiliateUrl");

            function updateShippingFields() {

                const isAmazon =
                    productType.value === "AmazonAffiliate";

                const isPhysical =
                    requiresShipping.value === "true";

                shippingDimensionsSection.style.display =
                    !isAmazon && isPhysical
                        ? "block"
                        : "none";
            }

            function updateProductFields() {

                const isAmazon =
                    productType.value === "AmazonAffiliate";

                amazonLinkSection.style.display =
                    isAmazon ? "block" : "none";

                ownProductSection.style.display =
                    isAmazon ? "none" : "flex";

                shippingSection.style.display =
                    isAmazon ? "none" : "block";

                amazonImageNote.style.display =
                    isAmazon ? "block" : "none";

                ownProductNote.style.display =
                    isAmazon ? "none" : "block";

                amazonProductNote.style.display =
                    isAmazon ? "block" : "none";

                affiliateInput.required = isAmazon;

                if (!isAmazon) {
                    affiliateInput.value = "";
                }

                updateShippingFields();
            }

            productType.addEventListener(
                "change",
                updateProductFields);

            requiresShipping.addEventListener(
                "change",
                updateShippingFields);

            updateProductFields();
        });
    </script>
}
