@model IEnumerable<SengeleMinistries.Models.Product>

@{
    ViewData["Title"] = "Product Management";
}

<!-- =========================================================
     SENGELE MINISTRIES ADMIN - PRODUCT MANAGEMENT
     ========================================================= -->

<section class="products-admin-hero">

    <div class="products-admin-hero-inner">

        <div class="products-admin-hero-content">

            <p class="products-admin-kicker">
                SENGELE MINISTRIES ADMIN
            </p>

            <h1>
                Product <span>Management.</span>
            </h1>

            <p class="products-admin-intro">
                Manage books, teachings, event collections and apparel
                available through the Sengele Ministries Shop.
            </p>

        </div>

        <div class="products-admin-hero-action">

            <a asp-area="Admin"
               asp-controller="Products"
               asp-action="Create"
               class="products-admin-add-btn">
                + Add Product
            </a>

        </div>

    </div>

</section>


<!-- =========================================================
     PRODUCT LISTING
     ========================================================= -->

<section class="products-admin-section">

    <div class="products-admin-container">


        @if (TempData["SuccessMessage"] != null)
        {
            <div class="products-admin-success">
                @TempData["SuccessMessage"]
            </div>
        }

        @if (TempData["Success"] != null)
        {
            <div class="products-admin-success">
                @TempData["Success"]
            </div>
        }


        <div class="products-admin-listing-header">

            <div>
                <p class="products-admin-small-title">
                    PRODUCT LISTING
                </p>

                <h2>
                    Your Products
                </h2>

                <p>
                    Review and manage the products currently available
                    in your ministry store.
                </p>
            </div>

            <div class="products-admin-count">
                @Model.Count() Products
            </div>

        </div>


        @if (Model == null || !Model.Any())
        {
            <!-- =================================================
                 EMPTY PRODUCT STATE
                 ================================================= -->

            <div class="products-admin-empty">

                <div class="products-admin-empty-symbol">
                    +
                </div>

                <h3>
                    No products yet
                </h3>

                <p>
                    Your product catalog is currently empty.
                    Add your first product to begin building the
                    Sengele Ministries Shop.
                </p>

                <a asp-area="Admin"
                   asp-controller="Products"
                   asp-action="Create"
                   class="products-admin-add-btn">
                    Add First Product
                </a>

            </div>
        }
        else
        {
            <!-- =================================================
                 PRODUCT TABLE
                 ================================================= -->

            <div class="products-admin-table-card">

                <div class="products-admin-table-scroll">

                    <table class="products-admin-table">

                        <thead>

                            <tr>

                                <th>
                                    Product
                                </th>

                                <th>
                                    Category
                                </th>

                                <th>
                                    Price
                                </th>

                                <th>
                                    Stock
                                </th>

                                <th>
                                    Status
                                </th>

                                <th class="products-admin-action-heading">
                                    Actions
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            @foreach (var product in Model)
                            {
                                <tr>

                                    <!-- PRODUCT -->

                                    <td>

                                        <div class="products-admin-product-info">

                                            <div class="products-admin-product-title">
                                                @product.Title
                                            </div>

                                            @if (!string.IsNullOrWhiteSpace(product.ShortDescription))
                                            {
                                                <div class="products-admin-product-description">
                                                    @product.ShortDescription
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="products-admin-product-description">
                                                    No description
                                                </div>
                                            }

                                        </div>

                                    </td>


                                    <!-- CATEGORY -->

                                    <td>

                                        <span class="products-admin-category">
                                            @product.Category
                                        </span>

                                    </td>


                                    <!-- PRICE -->

                                    <td>

                                        <span class="products-admin-price">
                                            @product.Price.ToString("C")
                                        </span>

                                    </td>


                                    <!-- STOCK -->

                                    <td>

                                        @if (product.StockQuantity.HasValue)
                                        {
                                            <span>
                                                @product.StockQuantity
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="products-admin-muted">
                                                —
                                            </span>
                                        }

                                    </td>


                                    <!-- STATUS -->

                                    <td>

                                        @if (product.IsPublished)
                                        {
                                            <span class="products-admin-status products-admin-published">
                                                Published
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="products-admin-status products-admin-draft">
                                                Draft
                                            </span>
                                        }

                                    </td>


                                    <!-- ACTIONS -->

                                    <td>

                                        <div class="products-admin-actions">

                                            <a asp-area="Admin"
                                               asp-controller="Products"
                                               asp-action="Edit"
                                               asp-route-id="@product.ProductId"
                                               class="products-admin-edit-btn">
                                                Edit
                                            </a>

                                            <a asp-area="Admin"
                                               asp-controller="Products"
                                               asp-action="Delete"
                                               asp-route-id="@product.ProductId"
                                               class="products-admin-delete-btn">
                                                Delete
                                            </a>

                                        </div>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>
        }


        <!-- =====================================================
             BOTTOM ACTION
             ===================================================== -->

        <div class="products-admin-bottom">

            <div>

                <p class="products-admin-small-title">
                    SENGELE MINISTRIES SHOP
                </p>

                <h3>
                    Continue building your collection.
                </h3>

            </div>

            <a asp-area="Admin"
               asp-controller="Products"
               asp-action="Create"
               class="products-admin-secondary-btn">
                + Add Another Product
            </a>

        </div>


    </div>

</section>