@model SengeleMinistries.Models.Order

@{
    ViewData["Title"] = "Checkout";
}

<div class="container py-5 mt-5">

    <div class="text-center mb-5">
        <p class="text-uppercase small mb-2">
            Sengele Ministries Shop
        </p>

        <h1 class="fw-bold">CHECKOUT</h1>

        <p class="text-muted">
            Complete your information to place your order.
        </p>
    </div>

    <div class="row g-5">

        <!-- CUSTOMER INFORMATION -->
        <div class="col-lg-7">

            <div class="border rounded p-4 bg-white">

                <h3 class="mb-4">
                    Shipping Information
                </h3>

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <form asp-controller="Checkout"
                      asp-action="PlaceOrder"
                      method="post"
                      id="checkout-form">

                    @Html.AntiForgeryToken()

                    <div class="row">

                        <div class="col-md-6 mb-3">
                            <label asp-for="FirstName"
                                   class="form-label">
                                First Name
                            </label>

                            <input asp-for="FirstName"
                                   class="form-control"
                                   readonly />
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="LastName"
                                   class="form-label">
                                Last Name
                            </label>

                            <input asp-for="LastName"
                                   class="form-control"
                                   readonly />
                        </div>

                    </div>

                    <div class="mb-3">
                        <label asp-for="Email"
                               class="form-label">
                            Email
                        </label>

                        <input asp-for="Email"
                               class="form-control"
                               readonly />
                    </div>

                    <div class="mb-3">
                        <label asp-for="Phone"
                               class="form-label">
                            Phone Number
                        </label>

                        <input asp-for="Phone"
                               class="form-control"
                               placeholder="Phone number" />

                        <span asp-validation-for="Phone"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Address"
                               class="form-label">
                            Street Address
                        </label>

                        <input asp-for="Address"
                               class="form-control"
                               placeholder="Street address" />

                        <span asp-validation-for="Address"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="row">

                        <div class="col-md-5 mb-3">
                            <label asp-for="City"
                                   class="form-label">
                                City
                            </label>

                            <input asp-for="City"
                                   class="form-control"
                                   placeholder="City" />

                            <span asp-validation-for="City"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="col-md-3 mb-3">
                            <label asp-for="State"
                                   class="form-label">
                                State
                            </label>

                            <input asp-for="State"
                                   class="form-control"
                                   placeholder="WA" />

                            <span asp-validation-for="State"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="col-md-4 mb-3">
                            <label asp-for="ZipCode"
                                   class="form-label">
                                ZIP Code
                            </label>

                            <input asp-for="ZipCode"
                                   class="form-control"
                                   placeholder="ZIP Code" />

                            <span asp-validation-for="ZipCode"
                                  class="text-danger">
                            </span>
                        </div>

                    </div>

                    <hr class="my-4" />

                    <!-- STRIPE PAYMENT -->
                    <h4 class="mb-3">
                        Secure Payment
                    </h4>

                    <div class="border rounded p-3 mb-4">

                        <div class="d-flex align-items-center gap-2 mb-2">
                            <strong>
                                Credit or Debit Card
                            </strong>
                        </div>

                        <p class="text-muted small">
                            Secure payment powered by Stripe.
                        </p>

                        <!-- Stripe Payment Element -->
                        <div id="checkout-payment-element">
                        </div>

                        <div id="checkout-payment-message"
                             class="text-danger small mt-3"
                             role="alert">
                        </div>

                    </div>

                    <input type="hidden"
                           asp-for="MemberId" />

                    <input type="hidden"
                           asp-for="Subtotal" />

                    <input type="hidden"
                           asp-for="Total" />

                    <!-- Disabled until Stripe is connected -->
                    <button type="submit"
                            id="checkout-submit"
                            class="btn btn-dark btn-lg w-100"
                            disabled>
                        PAY SECURELY
                    </button>

                    <p class="small text-muted text-center mt-3">
                        Payment will be enabled after
                        secure checkout configuration.
                    </p>

                </form>

            </div>

        </div>

        <!-- ORDER SUMMARY -->
        <div class="col-lg-5">

            <div class="border rounded p-4 bg-light">

                <h3 class="mb-4">
                    Order Summary
                </h3>

                <div class="d-flex justify-content-between mb-3">
                    <span>Subtotal</span>

                    <strong>
                        $@Model.Subtotal.ToString("0.00")
                    </strong>
                </div>

                <hr />

                <div class="d-flex justify-content-between">

                    <strong>Total</strong>

                    <strong class="fs-4">
                        $@Model.Total.ToString("0.00")
                    </strong>

                </div>

                <p class="small text-muted mt-4 mb-0">
                    Your payment will be securely
                    processed by Stripe.
                </p>

            </div>

            <div class="mt-3">
                <a asp-controller="Cart"
                   asp-action="Index"
                   class="btn btn-outline-dark w-100">
                    BACK TO CART
                </a>
            </div>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
