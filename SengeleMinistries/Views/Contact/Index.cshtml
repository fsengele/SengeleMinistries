@{
	ViewData["Title"] = "CONTACT US";
}

<section class="section section--soft contact-hero">
	<div class="container-wide">
		<h1 class="contact-title">CONTACT US</h1>
		<p class="lead muted">We would love to hear from you.</p>
		<p class="muted">Please use the contact details below to reach our ministry. We welcome visitors, calls and emails.</p>
	</div>
</section>

<main>
	<section class="section section--white">
		<div class="container-wide">
			<div class="contact-cards">
				<article class="contact-card">
					<h4 class="card-title">VISIT US</h4>
					<p class="card-body">
						<strong>Highline College</strong><br />
						<a class="contact-link" href="https://www.google.com/maps?q=2400+S+240th+St+Des+Moines+WA+98198" target="_blank" rel="noopener">
							2400 S 240th St<br />
							Des Moines, WA 98198<br />
							United States
						</a>
					</p>
				</article>

				<article class="contact-card">
					<h4 class="card-title">CALL US</h4>
					<p class="card-body"><a class="contact-link" href="tel:+14255249990">+1 (425) 524-9990</a></p>
				</article>

				<article class="contact-card">
					<h4 class="card-title">EMAIL US</h4>
					<p class="card-body"><a class="contact-link" href="mailto:contact@francis.sengele@gmail.com">contact@francis.sengele@gmail.com</a></p>
				</article>
			</div>
		</div>
	</section>

	<section class="section section--dark contact-cta">
		<div class="container-wide text-center">
			<h3 class="contact-cta-title">HOPE • PRAYER • THE WORD</h3>
			<p class="muted">You are welcome here. Join our community in prayer and teaching.</p>
		</div>
	</section>
</main>
