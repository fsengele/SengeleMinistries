@{
    ViewData["Title"] = "Contactez-nous";
}

<!-- CONTACT HERO -->
<section class="sm-contact-hero">
    <div class="container-wide sm-contact-hero-inner">

        <p class="sm-contact-eyebrow">SENGELE MINISTRIES</p>

        <h1>
            RESTONS
            <span>CONNECTÉS.</span>
        </h1>

        <p class="sm-contact-intro">
            Nous aimerions beaucoup vous entendre.
            Que vous souhaitiez nous rendre visite, nous appeler
            ou nous écrire, notre équipe est disponible pour vous accueillir.
        </p>

    </div>
</section>


<!-- CONTACT INFORMATION -->
<section class="sm-contact-section">
    <div class="container-wide">

        <div class="sm-contact-heading">
            <div>
                <p class="sm-contact-small-title">NOUS CONTACTER</p>
                <h2>Nous sommes à votre écoute.</h2>
            </div>

            <p>
                Choisissez simplement le moyen qui vous convient
                pour entrer en contact avec Sengele Ministries.
            </p>
        </div>


        <div class="sm-contact-grid">

            <!-- ADDRESS -->
            <article class="sm-contact-box sm-contact-address">

                <div class="sm-contact-number">01</div>

                <div class="sm-contact-icon">
                    <span>⌖</span>
                </div>

                <p class="sm-contact-label">NOTRE ADRESSE</p>

                <h3>Visitez-nous</h3>

                <p class="sm-contact-description">
                    Nous serons heureux de vous accueillir.
                </p>

                <a class="sm-contact-value"
                   href="https://www.google.com/maps?q=5113+200TH+STREET+CT+SPANAWAY+WA+98387"
                   target="_blank"
                   rel="noopener">

                    5113 200TH STREET CT<br />
                    Spanaway, WA 98387<br />
                    United States
                </a>

                <a class="sm-contact-action"
                   href="https://www.google.com/maps?q=5113+200TH+STREET+CT+SPANAWAY+WA+98387"
                   target="_blank"
                   rel="noopener">
                    OUVRIR DANS GOOGLE MAPS →
                </a>

            </article>


            <!-- PHONE -->
            <article class="sm-contact-box sm-contact-phone">

                <div class="sm-contact-number">02</div>

                <div class="sm-contact-icon">
                    <span>☎</span>
                </div>

                <p class="sm-contact-label">PAR TÉLÉPHONE</p>

                <h3>Appelez-nous</h3>

                <p class="sm-contact-description">
                    Une question ou besoin de nous parler directement ?
                </p>

                <a class="sm-contact-value"
                   href="tel:+14255249990">
                    +1 (425) 524-9990
                </a>

                <a class="sm-contact-action"
                   href="tel:+14255249990">
                    APPELER MAINTENANT →
                </a>

            </article>


            <!-- EMAIL -->
            <article class="sm-contact-box sm-contact-email">

                <div class="sm-contact-number">03</div>

                <div class="sm-contact-icon">
                    <span>✉</span>
                </div>

                <p class="sm-contact-label">PAR COURRIEL</p>

                <h3>Écrivez-nous</h3>

                <p class="sm-contact-description">
                    Envoyez-nous votre message et nous vous répondrons
                    dès que possible.
                </p>

                <a class="sm-contact-value sm-contact-email-value"
                   href="mailto:contact@francis.sengele@gmail.com">
                    contact@francis.sengele@gmail.com
                </a>

                <a class="sm-contact-action"
                   href="mailto:contact@francis.sengele@gmail.com">
                    ENVOYER UN COURRIEL →
                </a>

            </article>

        </div>
    </div>
</section>


<!-- PRAYER / HOPE CTA -->
<section class="sm-contact-prayer">

    <div class="container-wide sm-contact-prayer-inner">

        <div>
            <p class="sm-contact-small-title">
                PRIÈRE • ESPÉRANCE • PAROLE
            </p>

            <h2>
                Vous n'avez pas à marcher seul.
            </h2>

            <p>
                Nous croyons dans la puissance de la prière.
                Si vous traversez une saison difficile ou si vous
                souhaitez simplement que quelqu'un prie avec vous,
                nous sommes là.
            </p>
        </div>

        <a asp-controller="Prayer"
           asp-action="Index"
           class="sm-contact-prayer-btn">
            DEMANDER UNE PRIÈRE
        </a>

    </div>

</section>