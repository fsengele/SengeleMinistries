@{
    ViewData["Title"] = "Events";
}

<!-- =========================================================
     EVENTS HERO
     ========================================================= -->

<header class="events-hero">

    <div class="container-wide events-hero-content">

        <div class="events-hero-grid">


            <!-- LEFT SIDE -->
            <div class="events-hero-copy">

                <p class="events-kicker">
                    SENGELE MINISTRIES
                </p>


                <h1>
                    LET US<br />
                    <span>GATHER.</span>
                </h1>


                <p class="events-hero-description">
                    Join us to pray, hear the Word and gather
                    in fellowship. All are welcome.
                </p>


                <div class="events-gold-line"></div>

            </div>



            <!-- RIGHT SIDE : PHOTO AND SENGELE MINISTRIES -->
            <div class="events-hero-image">

                <div class="feature-message-image">

                    <img src="~/images/Francis10.jpeg"
                         alt="Sengele Ministries Events" />


                    <div class="feature-image-label">

                        <span>
                            SENGELE
                        </span>

                        <strong>
                            MINISTRIES
                        </strong>

                    </div>

                </div>

            </div>


        </div>

    </div>

</header>



<main>


    <!-- =========================================================
         EVENTS LIST
         ========================================================= -->

    <section class="events-section">

        <div class="container-wide">

            <div class="events-list">


                <!-- EVENT 01 -->
                <article class="event-row">

                    <div class="event-meta">

                        <div class="event-number">
                            01
                        </div>

                        <div class="event-label">
                            WEEKLY / PRAYER
                        </div>

                    </div>


                    <div class="event-body">

                        <h3 class="event-title">
                            ONLINE<br />
                            PRAYER TIMES
                        </h3>


                        <p class="event-desc muted">
                            12h25 — Washington State<br />
                            21h25 — Paris
                        </p>

                    </div>

                </article>



                <div class="event-sep"
                     aria-hidden="true">
                </div>



                <!-- EVENT 02 -->
                <article class="event-row">

                    <div class="event-meta">

                        <div class="event-number">
                            02
                        </div>

                        <div class="event-label">
                            MONTHLY / GATHERING
                        </div>

                    </div>


                    <div class="event-body">

                        <h3 class="event-title">
                            FIRST SATURDAY<br />
                            GATHERING
                        </h3>


                        <p class="event-desc muted">

                            Chaque premier samedi du mois, nous organisons
                            un grand programme spirituel où des personnes
                            viennent de partout pour répondre à l’appel et
                            à la direction que le Seigneur nous a donnée
                            pour la bénédiction de son peuple.

                            Le programme inclut prière, message
                            et temps d’édification.

                        </p>

                    </div>

                </article>


            </div>

        </div>

    </section>



    <!-- =========================================================
         CLOSING SECTION
         ========================================================= -->

    <section class="events-close">

        <div class="container-wide text-center">

            <div class="eyebrow">
                COME AS YOU ARE
            </div>


            <h2 class="close-head">
                IL Y A UNE PLACE<br />
                POUR VOUS.
            </h2>


            <p class="muted">
                We gather to pray, to hear the Word
                and to stand together in hope.
            </p>

        </div>

    </section>


</main>