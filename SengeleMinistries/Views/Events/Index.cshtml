@using System.Globalization

@{
    bool isFrench = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "fr";

    ViewData["Title"] = isFrench ? "Événements" : "Events";
}

<!-- Deep cinematic hero for Events -->
<section class="events-hero">
    <div class="hero-inner">
        <div class="hero-grid">
            <div>
                <div class="hero-kicker">SENGELE MINISTRIES</div>

                <h1 class="hero-title">
                    @if (isFrench)
                    {
                        <text>RASSEMBLONS-<br /><span class="gold">NOUS.</span></text>
                    }
                    else
                    {
                        <text>LET US<br /><span class="gold">GATHER.</span></text>
                    }
                </h1>

                <p class="hero-sub">
                    @(isFrench
                        ? "Rejoignez-nous pour prier, écouter la Parole et partager un moment de communion fraternelle. Tous sont les bienvenus."
                        : "Join us to pray, hear the Word and gather in fellowship. All are welcome.")
                </p>

                <div class="gold-line" aria-hidden="true"></div>
            </div>

            <div aria-hidden="true" class="hero-media"></div>
        </div>
    </div>
</section>

<main>
    <!-- Events list -->
    <section class="events-section">
        <div class="container-wide">
            <div class="events-list">

                <!-- EVENT 01 -->
                <article class="event-row">
                    <div class="event-meta">
                        <div class="event-number">01</div>

                        <div class="event-label">
                            @(isFrench
                                ? "HEBDOMADAIRE / PRIÈRE"
                                : "WEEKLY / PRAYER")
                        </div>
                    </div>

                    <div class="event-body">
                        <h3 class="event-title">
                            @if (isFrench)
                            {
                                <text>TEMPS DE PRIÈRE<br />EN LIGNE</text>
                            }
                            else
                            {
                                <text>ONLINE<br />PRAYER TIMES</text>
                            }
                        </h3>

                        <p class="event-desc muted">
                            12h25 — Washington State<br />
                            21h25 — Paris
                        </p>
                    </div>
                </article>

                <div class="event-sep" aria-hidden="true"></div>

                <!-- EVENT 02 -->
                <article class="event-row">
                    <div class="event-meta">
                        <div class="event-number">02</div>

                        <div class="event-label">
                            @(isFrench
                                ? "MENSUEL / RASSEMBLEMENT"
                                : "MONTHLY / GATHERING")
                        </div>
                    </div>

                    <div class="event-body">
                        <h3 class="event-title">
                            @if (isFrench)
                            {
                                <text>RASSEMBLEMENT DU<br />PREMIER SAMEDI</text>
                            }
                            else
                            {
                                <text>FIRST SATURDAY<br />GATHERING</text>
                            }
                        </h3>

                        <p class="event-desc muted">
                            @(isFrench
                                ? "Chaque premier samedi du mois, nous organisons un grand programme spirituel où des personnes viennent de partout pour répondre à l’appel et à la direction que le Seigneur nous a donnée pour la bénédiction de son peuple. Le programme inclut prière, message et temps d’édification."
                                : "Every first Saturday of the month, we gather for a special spiritual program where people come together in response to the calling and direction the Lord has given us for the blessing of His people. The program includes prayer, a message and a time of spiritual edification.")
                        </p>
                    </div>
                </article>

            </div>
        </div>
    </section>

    <!-- Closing statement -->
    <section class="events-close">
        <div class="container-wide text-center">

            <div class="eyebrow">
                @(isFrench
                    ? "VENEZ COMME VOUS ÊTES"
                    : "COME AS YOU ARE")
            </div>

            <h2 class="close-head">
                @if (isFrench)
                {
                    <text>IL Y A UNE PLACE<br />POUR VOUS.</text>
                }
                else
                {
                    <text>THERE IS A PLACE<br />FOR YOU.</text>
                }
            </h2>

            <p class="muted">
                @(isFrench
                    ? "Nous nous rassemblons pour prier, écouter la Parole et nous tenir ensemble dans l’espérance."
                    : "We gather to pray, to hear the Word and to stand together in hope.")
            </p>

        </div>
    </section>
</main>