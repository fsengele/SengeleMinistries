@{
	ViewData["Title"] = "Events";
}

<!-- Deep cinematic hero for Events -->
<section class="events-hero">
	<div class="hero-inner">
		<div class="hero-grid">
			<div>
				<div class="hero-kicker">SENGELE MINISTRIES</div>
				<h1 class="hero-title">LET US<br /><span class="gold">GATHER.</span></h1>
				<p class="hero-sub">Join us to pray, hear the Word and gather in fellowship. All are welcome.</p>
				<div class="gold-line" aria-hidden="true"></div>
			</div>
			<div aria-hidden="true" class="hero-media"></div>
		</div>
	</div>
</section>

<main>
	<!-- Dark editorial events list continuing the hero depth -->
	<section class="events-section">
		<div class="container-wide">
			<div class="events-list">

				<article class="event-row">
					<div class="event-meta">
						<div class="event-number">01</div>
						<div class="event-label">WEEKLY / PRAYER</div>
					</div>
					<div class="event-body">
						<h3 class="event-title">ONLINE<br />PRAYER TIMES</h3>
						<p class="event-desc muted">12h25 — Washington State<br />21h25 — Paris</p>
					</div>
				</article>

				<div class="event-sep" aria-hidden="true"></div>

				<article class="event-row">
					<div class="event-meta">
						<div class="event-number">02</div>
						<div class="event-label">MONTHLY / GATHERING</div>
					</div>
					<div class="event-body">
						<h3 class="event-title">FIRST SATURDAY<br />GATHERING</h3>
						<p class="event-desc muted">Chaque premier samedi du mois, nous organisons un grand programme spirituel où des personnes viennent de partout pour répondre à l’appel et à la direction que le Seigneur nous a donnée pour la bénédiction de son peuple. Le programme inclut prière, message et temps d’édification.</p>
					</div>
				</article>

			</div>
		</div>
	</section>

	<!-- Strong closing statement before footer -->
	<section class="events-close">
		<div class="container-wide text-center">
			<div class="eyebrow">COME AS YOU ARE</div>
			<h2 class="close-head">IL Y A UNE PLACE<br />POUR VOUS.</h2>
			<p class="muted">We gather to pray, to hear the Word and to stand together in hope.</p>
		</div>
	</section>
</main>
