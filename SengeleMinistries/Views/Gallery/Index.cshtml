@{
	ViewData["Title"] = "Gallery";
}

<section class="hero gallery-hero">
	<div class="hero-inner">
		<div>
			<div class="eyebrow">MOMENTS DE FOI</div>
			<h1 class="hero-title">PLUS QUE DES IMAGES. UNE HISTOIRE.</h1>
			<p class="hero-sub muted">Une sélection de moments capturés lors de nos services, temps de prière et événements. Cliquez pour agrandir.</p>
		</div>
	</div>
</section>

<main>
	<section class="section section--white">
		<div class="container-wide">
			<div class="masonry-grid" id="masonryGrid">
				@* Use existing images from wwwroot/images *@
				@{
					var images = new string[] {
						"/images/IMG_7497.JPG",
						"/images/IMG_7498.JPG",
						"/images/AZWM6413.JPG",
						"/images/image.JPG",
						"/images/IMG_7495.JPG",
						"/images/TUEQ6134.JPG"
					};
				}

				@for (int i = 0; i < images.Length; i++)
				{
					<div class="masonry-item" data-index="@i">
						<img src="@images[i]" alt="Sengele Ministries photo @(i+1)" class="gallery-image" data-index="@i" />
					</div>
				}
			</div>
		</div>
	</section>
</main>

@* Lightbox overlay *@
<div id="lightbox" class="gallery-lightbox" aria-hidden="true">
	<button class="lb-close" aria-label="Close">×</button>
	<button class="lb-prev" aria-label="Previous">‹</button>
	<div class="lb-content">
		<img id="lbImage" src="" alt="" />
	</div>
	<button class="lb-next" aria-label="Next">›</button>
</div>

n@section Scripts {
	<script src="~/js/site.js"></script>
}
