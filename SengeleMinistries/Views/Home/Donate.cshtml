@{
	ViewData["Title"] = "Donate";
}

<section class="section section--white">
	<div class="container-wide" style="max-width:760px;margin:0 auto;text-align:center">
		<h1 class="lead-heading">Support Sengele Ministries</h1>
		<p class="muted">Thank you for considering a gift. Your support helps sustain the ministry's mission of hope, prayer and the Word. We are preparing a secure donation experience. For now, please contact us to discuss giving options.</p>

		<p class="mt-3"><a class="btn btn-cta" asp-controller="Contact" asp-action="Index">Contact to Give</a></p>

		<p class="muted mt-4">We will never store raw payment card details on this site. A secure third-party payment provider will be integrated in a future phase.</p>
	</div>
</section>