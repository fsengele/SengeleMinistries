@{
    ViewData["Title"] = "Give";
}

<div class="giving-page">

    <!-- ==========================================
         GIVE PAGE HEADER
         ========================================== -->
    <section class="giving-hero">
        <div class="giving-container giving-hero-inner">

            <p class="giving-eyebrow">
                SENGELE MINISTRIES
            </p>

            <h1>
                Give With Purpose
            </h1>

            <p class="giving-scripture">
                “God loves a cheerful giver.”
            </p>

            <p class="giving-scripture-reference">
                2 Corinthians 9:7
            </p>

            <p class="giving-intro">
                Your generosity helps Sengele Ministries continue sharing
                the message of hope, prayer and the Word.
                Give freely, securely and with purpose.
            </p>

        </div>
    </section>


    <div class="giving-container">

        <!-- ==========================================
             01 - CHOOSE YOUR GIFT
             ========================================== -->
        <section class="giving-section giving-amount-section">

            <div class="giving-step">
                <span class="giving-step-number">01</span>
                <span class="giving-step-title">
                    CHOOSE YOUR GIFT
                </span>
            </div>

            <h2>Select an amount</h2>

            <p class="giving-section-description">
                Choose an amount below or enter your own gift.
            </p>


            <!-- PRESET AMOUNTS -->
            <div class="giving-amounts">

                <button type="button"
                        class="giving-amount"
                        data-amount="20">
                    $20
                </button>

                <button type="button"
                        class="giving-amount"
                        data-amount="50">
                    $50
                </button>

                <button type="button"
                        class="giving-amount"
                        data-amount="100">
                    $100
                </button>

                <button type="button"
                        class="giving-amount active"
                        data-amount="250">
                    $250
                </button>

                <button type="button"
                        class="giving-amount"
                        data-amount="500">
                    $500
                </button>

                <button type="button"
                        class="giving-amount"
                        data-amount="1000">
                    $1,000
                </button>

            </div>


            <!-- OTHER AMOUNT -->
            <div class="giving-other-amount">

                <label for="customGivingAmount">
                    Other Amount
                </label>

                <div class="giving-custom-input">
                    <span>$</span>

                    <input type="number"
                           id="customGivingAmount"
                           min="1"
                           step="1"
                           placeholder="Enter amount" />
                </div>

            </div>


            <!-- SELECTED GIFT -->
            <div class="giving-selected-total">
                <span>Your Gift:</span>

                <strong id="selectedGivingAmount">
                    $250
                </strong>
            </div>

        </section>


        <!-- ==========================================
             02 - CHOOSE HOW TO GIVE
             ========================================== -->
        <section class="giving-section giving-method-section">

            <div class="giving-step">
                <span class="giving-step-number">02</span>

                <span class="giving-step-title">
                    CHOOSE HOW TO GIVE
                </span>
            </div>

            <h2>Give securely</h2>

            <p class="giving-section-description">
                Choose the giving method that is most convenient for you.
            </p>


            <div class="giving-method-grid">

                <!-- ==================================
                     ZELLE
                     ================================== -->
                <article class="giving-method-card">

                    <p class="giving-method-label">
                        ZELLE
                    </p>

                    <h3>
                        Give with Zelle
                    </h3>

                    <p class="giving-method-description">
                        Send your gift directly using the official
                        Zelle information for Sengele Ministries.
                    </p>

                    <div class="giving-method-info">
                        <span>
                            Zelle Giving Information
                        </span>

                        <strong>
                            francis.sengele@gmail.com
                        </strong>
                    </div>

                    <a href="mailto:francis.sengele@gmail.com"
                       class="giving-method-button giving-method-link">
                        GIVE WITH ZELLE
                    </a>

                </article>


                <!-- ==================================
                     CASH APP
                     ================================== -->
                <article class="giving-method-card">

                    <p class="giving-method-label">
                        CASH APP
                    </p>

                    <h3>
                        Give with Cash App
                    </h3>

                    <p class="giving-method-description">
                        Give quickly through the official
                        Sengele Ministries Cash App account.
                    </p>

                    <div class="giving-method-info">
                        <span>
                            Cash App Giving Information
                        </span>

                        <strong>
                            $francissengel
                        </strong>
                    </div>

                    <a href="https://cash.app/$francissengel"
                       target="_blank"
                       rel="noopener noreferrer"
                       class="giving-method-button giving-method-link">
                        GIVE WITH CASH APP
                    </a>

                </article>

            </div>

        </section>


        <!-- ==========================================
             GIVE PRIVATELY
             ========================================== -->
        <section class="giving-privacy">

            <h2>
                Give Privately. Give Freely.
            </h2>

            <p>
                Your gift is an act of worship between you and God.
                You do not need to contact us before giving.
            </p>

            <blockquote>
                “When you give to the needy, do not let your left hand
                know what your right hand is doing.”
            </blockquote>

            <p class="giving-privacy-reference">
                Matthew 6:3
            </p>

        </section>


        <!-- ==========================================
             SECURITY MESSAGE
             ========================================== -->
        <section class="giving-security">

            <strong>
                Your security matters.
            </strong>

            <p>
                Sengele Ministries will never ask for your online banking
                password, PIN, routing number or bank account number
                through this page.
            </p>

        </section>

    </div>

</div>


@section Scripts {

    <script>

        // ==========================================
        // GIVING AMOUNT SELECTION
        // ==========================================

        document.addEventListener("DOMContentLoaded", function () {

            const amountButtons =
                document.querySelectorAll(".giving-amount");

            const customAmount =
                document.getElementById("customGivingAmount");

            const selectedAmount =
                document.getElementById("selectedGivingAmount");


            // ======================================
            // PRESET AMOUNT BUTTONS
            // ======================================

            amountButtons.forEach(function (button) {

                button.addEventListener("click", function () {

                    amountButtons.forEach(function (item) {
                        item.classList.remove("active");
                    });

                    button.classList.add("active");

                    const amount =
                        Number(button.dataset.amount);

                    selectedAmount.textContent =
                        "$" + amount.toLocaleString();

                    customAmount.value = "";

                });

            });


            // ======================================
            // CUSTOM GIVING AMOUNT
            // ======================================

            customAmount.addEventListener("input", function () {

                amountButtons.forEach(function (item) {
                    item.classList.remove("active");
                });

                const amount =
                    Number(customAmount.value);

                if (amount > 0) {

                    selectedAmount.textContent =
                        "$" + amount.toLocaleString();

                }
                else {

                    selectedAmount.textContent = "$0";

                }

            });

        });

    </script>

}