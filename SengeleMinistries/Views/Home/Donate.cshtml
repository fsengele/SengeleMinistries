
@using System.Globalization
@{
    ViewData["Title"] = "Give";
    bool isFrench = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "fr";
}

<style>
    /* ANIMATIONS */
    .giving-page .giving-reveal {
        opacity: 0;
        transform: translateY(28px);
        transition: opacity .75s ease, transform .75s ease;
    }

    .giving-page .giving-reveal.is-visible {
        opacity: 1;
        transform: translateY(0);
    }

    /* AMOUNT BUTTONS */
    .giving-page .giving-amount {
        transition: transform .22s ease, color .22s ease;
    }

    .giving-page .giving-amount:hover {
        transform: translateY(-4px);
    }

    .giving-page .giving-amounts {
        position: relative;
        isolation: isolate;
    }

    .giving-page .giving-hover-highlight {
        position: absolute;
        z-index: 0;
        left: 0;
        top: 0;
        width: 0;
        height: 0;
        border-radius: 6px;
        background: linear-gradient(
            120deg, #96732e, #dfbd68, #c9a24d
        );
        box-shadow: 0 10px 25px rgba(166,129,40,.34);
        pointer-events: none;
        opacity: 0;
        transition:
            transform .34s cubic-bezier(.22,1,.36,1),
            width .34s,
            height .34s,
            opacity .2s;
    }

    .giving-page .giving-amounts .giving-amount {
        position: relative;
        z-index: 1;
        background: transparent !important;
    }

    .giving-page .giving-amount.highlighted {
        color: #111 !important;
        border-color: transparent !important;
    }

    .giving-page .giving-amount.active {
        border-color: #c9a24d;
    }

    /* UNIFIED PAYMENT FORM */
    .giving-page .giving-unified-payment {
        max-width: 800px;
        margin: 0 auto;
        padding: clamp(18px, 4vw, 36px);
        background: #fff;
        border: 1px solid #e3ded2;
    }

    .giving-page .giving-payment-choices {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 10px;
        margin-bottom: 26px;
    }

    .giving-page .giving-payment-choice {
        cursor: pointer;
        min-width: 0;
    }

    .giving-page .giving-payment-choice input {
        position: absolute;
        opacity: 0;
        width: 1px;
        height: 1px;
    }

    .giving-page .giving-payment-choice span {
        display: flex;
        justify-content: center;
        align-items: center;
        text-align: center;
        min-height: 64px;
        padding: 10px;
        border: 1px solid #d9d5cb;
        background: #fff;
        font-size: 13px;
        font-weight: 700;
        transition: background .2s, border-color .2s;
    }

    .giving-page .giving-payment-choice input:checked + span {
        border-color: #a68128;
        background: #f7f0df;
        box-shadow: inset 0 0 0 1px #a68128;
    }

    .giving-page .giving-payment-choice input:focus-visible + span {
        outline: 3px solid #a68128;
        outline-offset: 3px;
    }

    .giving-page .giving-payment-details[hidden],
    .giving-page .giving-stripe-panel[hidden] {
        display: none !important;
    }

    .giving-page .giving-payment-details h3 {
        margin-bottom: 16px;
    }

    .giving-page .giving-payment-details .giving-method-info {
        margin: 18px 0;
    }

    .giving-page .giving-payment-badge {
        display: inline-block;
        padding: 8px 12px;
        margin-bottom: 18px;
        background: #f7f5ef;
        color: #8d6d2d;
        border: 1px solid #dedbd2;
        font-size: 11px;
        font-weight: 800;
        letter-spacing: 1px;
    }

    .giving-page .giving-card-notice {
        margin-bottom: 18px;
        color: #77756f;
        font-size: 14px;
        line-height: 1.6;
    }

    .giving-page .giving-stripe-panel {
        margin-top: 22px;
    }

    .giving-page #payment-element {
        margin: 20px 0;
    }

    .giving-page .giving-status {
        margin-top: 14px;
        color: #77756f;
        font-size: 13px;
        line-height: 1.6;
    }

    .giving-page #stripeMessage[role="alert"] {
        color: #a12626;
    }

    .giving-page #stripeMessage[data-success="true"] {
        color: #167347;
        font-weight: 700;
        font-size: 16px;
    }

    .giving-page .giving-method-button {
        transition: transform .2s, background-color .2s;
    }

    .giving-page .giving-method-button:hover {
        transform: translateY(-2px);
    }

    .giving-page .giving-method-button:disabled {
        opacity: .6;
        cursor: not-allowed;
    }

    .giving-page .giving-method-button:focus-visible {
        outline: 3px solid #a68128;
        outline-offset: 3px;
    }

    .giving-page .giving-selected-total {
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
    }

    .giving-page .giving-selected-total strong {
        font-size: 26px;
        font-weight: 800;
    }

    .giving-page .giving-custom-input:focus-within {
        border-color: #a68128;
        box-shadow: 0 0 0 3px rgba(166,129,40,.12);
    }

    @@media (max-width: 650px) {
        .giving-page .giving-payment-choices {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (prefers-reduced-motion: reduce) {
        .giving-page .giving-reveal {
            opacity: 1;
            transform: none;
            transition: none;
        }

        .giving-page .giving-amount,
        .giving-page .giving-hover-highlight {
            transition: none;
        }
    }
</style>

<div class="giving-page">

    <!-- HERO -->
    <section class="giving-hero">
        <div class="giving-container giving-hero-inner giving-reveal">

            <p class="giving-eyebrow">
                SENGELE MINISTRIES
            </p>

            <h1>
                @(isFrench ? "Donnez avec un objectif" : "Give With Purpose")
            </h1>

            <p class="giving-scripture">
                @(isFrench
                    ? "« Dieu aime celui qui donne avec joie. »"
                    : "“God loves a cheerful giver.”")
            </p>

            <p class="giving-scripture-reference">
                @(isFrench ? "2 Corinthiens 9:7" : "2 Corinthians 9:7")
            </p>

            <p class="giving-intro">
                @(isFrench
                    ? "Votre générosité aide Sengele Ministries à continuer de partager l'espérance, la prière et la Parole de Dieu. Donnez librement et avec un objectif."
                    : "Your generosity helps Sengele Ministries continue sharing the message of hope, prayer and the Word. Give freely and with purpose.")
            </p>

        </div>
    </section>

    <div class="giving-container">

        <!-- STEP 01 : AMOUNT -->
        <section class="giving-section giving-amount-section giving-reveal">

            <div class="giving-step">
                <span class="giving-step-number">01</span>
                <span class="giving-step-title">
                    @(isFrench ? "CHOISISSEZ VOTRE DON" : "CHOOSE YOUR GIFT")
                </span>
            </div>

            <h2>
                @(isFrench ? "Choisissez un montant" : "Select an amount")
            </h2>

            <p class="giving-section-description">
                @(isFrench
                    ? "Choisissez un montant ou entrez votre propre contribution."
                    : "Choose an amount below or enter your own gift.")
            </p>

            <div class="giving-amounts"
                 id="givingAmounts"
                 role="group"
                 aria-label="@(isFrench ? "Montant du don" : "Gift amount")">

                <span class="giving-hover-highlight"
                      aria-hidden="true"></span>

                <button type="button"
                        class="giving-amount"
                        data-amount="20"
                        aria-pressed="false">$20</button>

                <button type="button"
                        class="giving-amount"
                        data-amount="50"
                        aria-pressed="false">$50</button>

                <button type="button"
                        class="giving-amount"
                        data-amount="100"
                        aria-pressed="false">$100</button>

                <button type="button"
                        class="giving-amount active"
                        data-amount="250"
                        aria-pressed="true">$250</button>

                <button type="button"
                        class="giving-amount"
                        data-amount="500"
                        aria-pressed="false">$500</button>

                <button type="button"
                        class="giving-amount"
                        data-amount="1000"
                        aria-pressed="false">$1,000</button>
            </div>

            <div class="giving-other-amount">
                <label for="customGivingAmount">
                    @(isFrench ? "Autre montant" : "Other Amount")
                </label>

                <div class="giving-custom-input">
                    <span>$</span>
                    <input type="number"
                           id="customGivingAmount"
                           min="1"
                           max="10000"
                           step="0.01"
                           inputmode="decimal"
                           placeholder="@(isFrench ? "Entrez un montant" : "Enter amount")" />
                </div>
            </div>

            <div class="giving-selected-total" aria-live="polite">
                <span>
                    @(isFrench ? "Votre don :" : "Your Gift:")
                </span>

                <strong id="selectedGivingAmount">$250.00</strong>
            </div>

        </section>

        <!-- STEP 02 : PAYMENT METHODS -->
        <section class="giving-section giving-method-section giving-reveal">

            <div class="giving-step">
                <span class="giving-step-number">02</span>
                <span class="giving-step-title">
                    @(isFrench ? "MOYENS DE PAIEMENT" : "PAYMENT METHODS")
                </span>
            </div>

            <h2>
                @(isFrench
                    ? "Comment souhaitez-vous donner ?"
                    : "How would you like to give?")
            </h2>

            <p class="giving-section-description">
                @(isFrench
                    ? "Choisissez votre moyen de paiement."
                    : "Choose your preferred payment method.")
            </p>

            <div class="giving-unified-payment"
                 id="stripeDonationCard"
                 data-publishable-key="@ViewBag.StripePublishableKey">

                <!-- PAYMENT CHOICES -->
                <div class="giving-payment-choices"
                     role="radiogroup"
                     aria-label="@(isFrench ? "Moyen de paiement" : "Payment method")">

                    <label class="giving-payment-choice">
                        <input type="radio"
                               name="givingMethod"
                               value="card"
                               checked />
                        <span>
                            💳 @(isFrench ? "Carte bancaire" : "Credit / Debit Card")
                        </span>
                    </label>

                    <label class="giving-payment-choice">
                        <input type="radio"
                               name="givingMethod"
                               value="paypal" />
                        <span>PayPal</span>
                    </label>

                    <label class="giving-payment-choice">
                        <input type="radio"
                               name="givingMethod"
                               value="zelle" />
                        <span>Zelle</span>
                    </label>

                    <label class="giving-payment-choice">
                        <input type="radio"
                               name="givingMethod"
                               value="cashapp" />
                        <span>Cash App</span>
                    </label>
                </div>

                <!-- STRIPE CARD -->
                <div class="giving-payment-details" id="cardMethodPanel">

                    <h3>
                        @(isFrench ? "Donner par carte" : "Give by Card")
                    </h3>

                    <p class="giving-card-notice">
                        @(isFrench
                            ? "Effectuez un don sécurisé avec Stripe. Mode test uniquement."
                            : "Make a secure donation with Stripe. Test mode only.")
                    </p>

                    <div class="giving-method-info">
                        <span>
                            @(isFrench ? "Montant sélectionné" : "Selected amount")
                        </span>
                        <strong id="cardGivingAmount">$250.00</strong>
                    </div>

                    <span class="giving-payment-badge">
                        STRIPE SANDBOX
                    </span>

                    <form id="stripeDonationForm" method="post">
                        @Html.AntiForgeryToken()

                        <button type="button"
                                id="startStripeDonation"
                                class="giving-method-button">
                            @(isFrench
                                ? "CONTINUER PAR CARTE"
                                : "CONTINUE WITH CARD")
                        </button>

                        <div id="stripePaymentPanel"
                             class="giving-stripe-panel"
                             hidden>

                            <div id="payment-element"></div>

                            <button type="submit"
                                    id="confirmStripeDonation"
                                    class="giving-method-button">
                                @(isFrench
                                    ? "CONFIRMER LE DON TEST"
                                    : "CONFIRM TEST DONATION")
                            </button>
                        </div>

                        <p id="stripeMessage"
                           class="giving-status"
                           aria-live="polite"></p>
                    </form>
                </div>

                <!-- PAYPAL -->
                <div class="giving-payment-details"
                     id="paypalMethodPanel"
                     hidden>

                    <h3>PayPal</h3>

                    <p class="giving-card-notice">
                        @(isFrench
                            ? "PayPal sera disponible après la connexion d'un compte PayPal autorisé à recevoir des paiements."
                            : "PayPal will be available after an eligible PayPal account is connected.")
                    </p>

                    <span class="giving-payment-badge">
                        @(isFrench ? "EN PRÉPARATION" : "COMING SOON")
                    </span>
                </div>

                <!-- ZELLE -->
                <div class="giving-payment-details"
                     id="zelleMethodPanel"
                     hidden>

                    <h3>
                        @(isFrench ? "Donner avec Zelle" : "Give with Zelle")
                    </h3>

                    <p>
                        @(isFrench
                            ? "Envoyez votre don à cette adresse avec votre application Zelle."
                            : "Send your donation to this address using Zelle.")
                    </p>

                    <div class="giving-method-info">
                        <strong>francis.sengele@gmail.com</strong>
                    </div>

                    <button type="button"
                            id="copyZelle"
                            class="giving-method-button">
                        @(isFrench
                            ? "COPIER L'ADRESSE ZELLE"
                            : "COPY ZELLE ADDRESS")
                    </button>

                    <p id="zelleCopyStatus"
                       class="giving-status"
                       aria-live="polite"></p>
                </div>

                <!-- CASH APP -->
                <div class="giving-payment-details"
                     id="cashappMethodPanel"
                     hidden>

                    <h3>
                        @(isFrench ? "Donner avec Cash App" : "Give with Cash App")
                    </h3>

                    <div class="giving-method-info">
                        <strong>$francissengel</strong>
                    </div>

                    <a href="https://cash.app/$francissengel"
                       target="_blank"
                       rel="noopener noreferrer"
                       class="giving-method-button giving-method-link">
                        @(isFrench
                            ? "OUVRIR CASH APP"
                            : "OPEN CASH APP")
                    </a>
                </div>
            </div>

            <p class="giving-status" id="givingAmountNote">
                @(isFrench
                    ? "Pour Zelle et Cash App, vérifiez le montant dans votre application avant de confirmer le don."
                    : "For Zelle and Cash App, confirm the amount in your payment app before sending your gift.")
            </p>

        </section>

        <!-- PRIVACY -->
        <section class="giving-privacy giving-reveal">

            <h2>
                @(isFrench
                    ? "Donnez librement. Donnez en privé."
                    : "Give Privately. Give Freely.")
            </h2>

            <p>
                @(isFrench
                    ? "Votre don est un acte d'adoration entre vous et Dieu. Vous n'avez pas besoin de nous contacter avant de donner."
                    : "Your gift is an act of worship between you and God. You do not need to contact us before giving.")
            </p>

            <blockquote>
                @(isFrench
                    ? "« Quand tu fais l'aumône, que ta main gauche ne sache pas ce que fait ta droite. »"
                    : "“When you give to the needy, do not let your left hand know what your right hand is doing.”")
            </blockquote>

            <p class="giving-privacy-reference">
                @(isFrench ? "Matthieu 6:3" : "Matthew 6:3")
            </p>
        </section>

        <!-- SECURITY -->
        <section class="giving-security giving-reveal">

            <strong>
                @(isFrench
                    ? "Votre sécurité est importante."
                    : "Your security matters.")
            </strong>

            <p>
                @(isFrench
                    ? "Les informations de carte sont traitées par Stripe. Sengele Ministries ne vous demandera jamais votre mot de passe bancaire ou votre code PIN."
                    : "Card details are processed by Stripe. Sengele Ministries will never ask for your banking password or PIN.")
            </p>
        </section>

    </div>
</div>

@section Scripts {
    <script src="https://js.stripe.com/v3/"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            // ==========================================
            // LANGUAGE
            // ==========================================
            const isFrench = @Html.Raw(
                System.Text.Json.JsonSerializer.Serialize(isFrench)
            );

            // ==========================================
            // ELEMENTS
            // ==========================================
            const amountButtons =
                document.querySelectorAll(".giving-amount");

            const customAmount =
                document.getElementById("customGivingAmount");

            const selectedAmount =
                document.getElementById("selectedGivingAmount");

            const cardAmount =
                document.getElementById("cardGivingAmount");

            const stripeCard =
                document.getElementById("stripeDonationCard");

            const stripeForm =
                document.getElementById("stripeDonationForm");

            const stripePanel =
                document.getElementById("stripePaymentPanel");

            const stripeStart =
                document.getElementById("startStripeDonation");

            const stripeConfirm =
                document.getElementById("confirmStripeDonation");

            const stripeMessage =
                document.getElementById("stripeMessage");

            const currency = new Intl.NumberFormat("en-US", {
                style: "currency",
                currency: "USD"
            });

            let selectedGift = 250;
            let stripeElements = null;
            let stripePaymentElement = null;
            let requestInProgress = false;
            let donationConfirmed = false;
            let activePaymentIntentId = null;

            const publishableKey =
                stripeCard.dataset.publishableKey;

                //JUSTE POUR LA FONCTIONNALITE MAIS CELA ET RETIRABLE

                console.log("Stripe public key available:", !!publishableKey);
                console.log("Stripe.js loaded:", typeof window.Stripe === "function");

            const stripe =
                publishableKey && window.Stripe
                    ? Stripe(publishableKey)
                    : null;

            // ==========================================
            // DISPLAY MESSAGES
            // ==========================================
            function showMessage(
                message,
                isError = false,
                isSuccess = false
            ) {
                stripeMessage.textContent = message;

                if (isError) {
                    stripeMessage.setAttribute("role", "alert");
                } else {
                    stripeMessage.removeAttribute("role");
                }

                if (isSuccess) {
                    stripeMessage.dataset.success = "true";
                } else {
                    delete stripeMessage.dataset.success;
                }
            }

            // ==========================================
            // SELECTED DONATION AMOUNT
            // ==========================================
            function currentGiftAmount() {

                if (customAmount.value !== "") {
                    return Number(customAmount.value);
                }

                const active =
                    document.querySelector(".giving-amount.active");

                return active
                    ? Number(active.dataset.amount)
                    : 0;
            }

            // ==========================================
            // RESET STRIPE PAYMENT FORM
            // ==========================================
            function invalidateStripeForm() {

                if (requestInProgress) {
                    return;
                }

                if (stripePaymentElement) {
                    stripePaymentElement.destroy();
                    stripePaymentElement = null;
                }

                stripeElements = null;
                activePaymentIntentId = null;
                donationConfirmed = false;

                stripePanel.hidden = true;
                stripeStart.hidden = false;
                stripeConfirm.disabled = false;

                showMessage("");
            }

            // ==========================================
            // UPDATE DONATION AMOUNT
            // ==========================================
            function updateAmount(amount) {

                const valid =
                    Number.isFinite(amount) && amount > 0
                        ? amount
                        : 0;

                selectedGift = valid;

                const formatted = currency.format(valid);

                selectedAmount.textContent = formatted;
                cardAmount.textContent = formatted;

                invalidateStripeForm();
            }

            // ==========================================
            // PAYMENT METHOD PANELS
            // ==========================================
            const methodPanels = {
                card: document.getElementById("cardMethodPanel"),
                paypal: document.getElementById("paypalMethodPanel"),
                zelle: document.getElementById("zelleMethodPanel"),
                cashapp: document.getElementById("cashappMethodPanel")
            };

            document.querySelectorAll(
                'input[name="givingMethod"]'
            ).forEach(function (radio) {

                radio.addEventListener("change", function () {

                    Object.entries(methodPanels).forEach(
                        function ([method, panel]) {
                            panel.hidden = method !== radio.value;
                        }
                    );

                    if (radio.value !== "card") {
                        invalidateStripeForm();
                    }
                });
            });

            // ==========================================
            // COPY ZELLE ADDRESS
            // ==========================================
            document.getElementById("copyZelle")
                .addEventListener("click", async function () {

                    const status =
                        document.getElementById("zelleCopyStatus");

                    try {
                        await navigator.clipboard.writeText(
                            "francis.sengele@gmail.com"
                        );

                        status.textContent = isFrench
                            ? "Adresse copiée."
                            : "Address copied.";

                    } catch {
                        status.textContent = isFrench
                            ? "Copiez l'adresse affichée ci-dessus."
                            : "Copy the address displayed above.";
                    }
                });

            // ==========================================
            // STRIPE VERIFICATION
            // ==========================================
            async function verifyDonation(paymentIntentId) {

                if (!paymentIntentId ||
                    !paymentIntentId.startsWith("pi_")) {

                    showMessage(
                        isFrench
                            ? "Référence du paiement introuvable."
                            : "Payment reference not found.",
                        true
                    );

                    return;
                }

                showMessage(
                    isFrench
                        ? "Vérification du don auprès de Stripe..."
                        : "Verifying your donation with Stripe..."
                );

                try {

                    const token = stripeForm.querySelector(
                        'input[name="__RequestVerificationToken"]'
                    ).value;

                    const body = new URLSearchParams({
                        paymentIntentId: paymentIntentId
                    });

                    const response = await fetch(
                        "/StripePayment/VerifyDonation",
                        {
                            method: "POST",
                            headers: {
                                "Content-Type":
                                    "application/x-www-form-urlencoded;charset=UTF-8",
                                "RequestVerificationToken": token
                            },
                            body: body.toString()
                        }
                    );

                    const result = await response.json();

                    if (!response.ok) {
                        throw new Error(
                            result.error || "Verification failed."
                        );
                    }

                    if (result.succeeded) {

                        donationConfirmed = true;

                        const formattedAmount =
                            currency.format(result.amount);

                        showMessage(
                            isFrench
                                ? "Merci ! Votre don de " +
                                  formattedAmount +
                                  " a été confirmé avec succès."
                                : "Thank you! Your donation of " +
                                  formattedAmount +
                                  " was confirmed successfully.",
                            false,
                            true
                        );

                        stripeConfirm.disabled = true;
                        stripeStart.hidden = true;

                    } else if (
                        result.status === "processing" ||
                        result.status === "requires_capture"
                    ) {

                        showMessage(
                            isFrench
                                ? "Votre paiement est en cours de traitement. Il n'est pas encore confirmé."
                                : "Your payment is processing and has not been confirmed yet."
                        );

                    } else {

                        showMessage(
                            isFrench
                                ? "Le don n'est pas encore confirmé. Statut : " +
                                  result.status
                                : "Your donation is not confirmed yet. Status: " +
                                  result.status,
                            true
                        );
                    }

                } catch (error) {

                    showMessage(
                        isFrench
                            ? "Impossible de vérifier le don pour le moment. Consultez le statut dans Stripe avant de réessayer."
                            : "Unable to verify the donation right now. Check its status in Stripe before trying again.",
                        true
                    );

                    console.error("Stripe verification error:", error);
                }
            }

            // ==========================================
            // CREATE STRIPE PAYMENT
            // ==========================================
            stripeStart.addEventListener("click", async function () {

                if (requestInProgress) return;

                const amount = currentGiftAmount();
                const cents = Math.round(amount * 100);

                if (!Number.isFinite(amount) ||
                    amount < 1 ||
                    amount > 10000 ||
                    Math.abs(amount * 100 - cents) > 0.000001) {

                    showMessage(
                        isFrench
                            ? "Entrez un montant valide entre 1 $ et 10 000 $, avec deux décimales maximum."
                            : "Enter a valid amount between $1 and $10,000 with no more than two decimal places.",
                        true
                    );

                    return;
                }

                if (!stripe) {

                    showMessage(
                        isFrench
                            ? "Stripe n'est pas encore configuré."
                            : "Stripe is not configured.",
                        true
                    );

                    return;
                }

                requestInProgress = true;
                stripeStart.disabled = true;

                showMessage(
                    isFrench
                        ? "Préparation du paiement..."
                        : "Preparing payment..."
                );

                try {

                    const token = stripeForm.querySelector(
                        'input[name="__RequestVerificationToken"]'
                    ).value;

                    const body = new URLSearchParams({
                        amount: amount.toFixed(2)
                    });

                    const response = await fetch(
                        "/StripePayment/CreateDonationIntent",
                        {
                            method: "POST",
                            headers: {
                                "Content-Type":
                                    "application/x-www-form-urlencoded;charset=UTF-8",
                                "RequestVerificationToken": token
                            },
                            body: body.toString()
                        }
                    );

                    const result = await response.json();

                    if (!response.ok || !result.clientSecret) {
                        throw new Error(
                            result.error || "Unable to prepare donation."
                        );
                    }

                    stripeElements = stripe.elements({
                        clientSecret: result.clientSecret
                    });

                    stripePaymentElement =
                        stripeElements.create("payment", {
                            layout: "tabs"
                        });

                    stripePaymentElement.mount("#payment-element");

                    activePaymentIntentId =
                        result.clientSecret.split("_secret_")[0];

                    stripePanel.hidden = false;
                    stripeStart.hidden = true;

                    showMessage("");

                } catch (error) {

                    showMessage(
                        error.message || "Payment setup failed.",
                        true
                    );

                } finally {

                    requestInProgress = false;
                    stripeStart.disabled = false;
                }
            });

            // ==========================================
            // CONFIRM STRIPE PAYMENT
            // ==========================================
            stripeForm.addEventListener(
                "submit",
                async function (event) {

                    event.preventDefault();

                    if (!stripe ||
                        !stripeElements ||
                        requestInProgress ||
                        donationConfirmed) {
                        return;
                    }

                    if (currentGiftAmount() !== selectedGift) {

                        invalidateStripeForm();

                        showMessage(
                            isFrench
                                ? "Le montant a changé. Recommencez le paiement."
                                : "The amount changed. Please restart payment.",
                            true
                        );

                        return;
                    }

                    requestInProgress = true;
                    stripeConfirm.disabled = true;

                    showMessage(
                        isFrench
                            ? "Traitement du paiement..."
                            : "Processing payment..."
                    );

                    const returnUrl = new URL(
                        "/Home/Donate",
                        window.location.origin
                    );

                    returnUrl.searchParams.set(
                        "stripe_return",
                        "1"
                    );

                    try {

                        const result =
                            await stripe.confirmPayment({
                                elements: stripeElements,
                                confirmParams: {
                                    return_url:
                                        returnUrl.toString()
                                },
                                redirect: "if_required"
                            });

                        if (result.error) {

                            showMessage(
                                result.error.message ||
                                    "Payment failed.",
                                true
                            );

                        } else if (result.paymentIntent) {

                            await verifyDonation(
                                result.paymentIntent.id
                            );

                        } else if (activePaymentIntentId) {

                            await verifyDonation(
                                activePaymentIntentId
                            );

                        } else {

                            showMessage(
                                isFrench
                                    ? "Paiement envoyé. Vérification en attente."
                                    : "Payment submitted. Verification pending."
                            );
                        }

                    } catch (error) {

                        showMessage(
                            error.message || "Payment failed.",
                            true
                        );

                    } finally {

                        requestInProgress = false;

                        if (!donationConfirmed) {
                            stripeConfirm.disabled = false;
                        }
                    }
                }
            );

            // ==========================================
            // VERIFY AFTER STRIPE REDIRECT
            // ==========================================
            const stripeReturnParams =
                new URLSearchParams(window.location.search);

            if (stripeReturnParams.has("stripe_return")) {

                const returnedPaymentIntent =
                    stripeReturnParams.get("payment_intent");

                if (returnedPaymentIntent) {

                    document.querySelector(
                        'input[name="givingMethod"][value="card"]'
                    ).checked = true;

                    Object.entries(methodPanels).forEach(
                        function ([method, panel]) {
                            panel.hidden = method !== "card";
                        }
                    );

                    stripePanel.hidden = true;
                    stripeStart.hidden = true;

                    verifyDonation(returnedPaymentIntent);

                } else {

                    showMessage(
                        isFrench
                            ? "Retour de Stripe. Aucune référence de paiement trouvée."
                            : "Returned from Stripe. No payment reference was found.",
                        true
                    );
                }
            }

            // ==========================================
            // GOLD HIGHLIGHT ANIMATION
            // ==========================================
            const amountGroup =
                document.getElementById("givingAmounts");

            const highlight =
                amountGroup.querySelector(".giving-hover-highlight");

            const reducedMotion = window.matchMedia(
                "(prefers-reduced-motion: reduce)"
            ).matches;

            function selectedButton() {
                return amountGroup.querySelector(
                    ".giving-amount.active"
                );
            }

            function moveHighlight(button) {

                amountButtons.forEach(function (item) {
                    item.classList.toggle(
                        "highlighted",
                        item === button
                    );
                });

                if (!button) {
                    highlight.style.opacity = "0";
                    return;
                }

                const groupRect =
                    amountGroup.getBoundingClientRect();

                const rect = button.getBoundingClientRect();

                highlight.style.width = rect.width + "px";
                highlight.style.height = rect.height + "px";

                highlight.style.transform =
                    "translate(" +
                    (rect.left - groupRect.left) + "px, " +
                    (rect.top - groupRect.top) + "px)";

                highlight.style.opacity = "1";
            }

            // ==========================================
            // AMOUNT BUTTON EVENTS
            // ==========================================
            amountButtons.forEach(function (button) {

                button.addEventListener("mouseenter", function () {
                    moveHighlight(button);
                });

                button.addEventListener("focus", function () {
                    moveHighlight(button);
                });

                button.addEventListener("click", function () {

                    if (requestInProgress) return;

                    amountButtons.forEach(function (item) {
                        item.classList.remove("active");
                        item.setAttribute("aria-pressed", "false");
                    });

                    button.classList.add("active");
                    button.setAttribute("aria-pressed", "true");

                    customAmount.value = "";

                    updateAmount(Number(button.dataset.amount));
                    moveHighlight(button);
                });
            });

            amountGroup.addEventListener("mouseleave", function () {
                moveHighlight(selectedButton());
            });

            amountGroup.addEventListener("focusout", function (event) {
                if (!amountGroup.contains(event.relatedTarget)) {
                    moveHighlight(selectedButton());
                }
            });

            window.addEventListener("resize", function () {
                moveHighlight(
                    amountGroup.querySelector(
                        ".giving-amount.highlighted"
                    ) || selectedButton()
                );
            });

            requestAnimationFrame(function () {
                moveHighlight(selectedButton());
            });

            // ==========================================
            // CUSTOM AMOUNT
            // ==========================================
            customAmount.addEventListener("input", function () {

                if (requestInProgress) return;

                amountButtons.forEach(function (item) {
                    item.classList.remove("active");
                    item.setAttribute("aria-pressed", "false");
                });

                updateAmount(Number(customAmount.value));
                moveHighlight(null);
            });

            // ==========================================
            // REVEAL ANIMATION
            // ==========================================
            const revealElements =
                document.querySelectorAll(".giving-reveal");

            if (!("IntersectionObserver" in window) || reducedMotion) {

                revealElements.forEach(function (element) {
                    element.classList.add("is-visible");
                });

            } else {

                const observer = new IntersectionObserver(
                    function (entries) {

                        entries.forEach(function (entry) {
                            if (entry.isIntersecting) {
                                entry.target.classList.add("is-visible");
                                observer.unobserve(entry.target);
                            }
                        });

                    },
                    {
                        threshold: 0.08,
                        rootMargin: "0px 0px -25px 0px"
                    }
                );

                revealElements.forEach(function (element) {
                    observer.observe(element);
                });
            }

            window.addEventListener("beforeprint", function () {
                revealElements.forEach(function (element) {
                    element.classList.add("is-visible");
                });
            });

        });
    </script>
}
