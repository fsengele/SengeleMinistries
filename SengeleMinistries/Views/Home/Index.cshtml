@{
    ViewData["Title"] = "Home";
}

<header class="hero hero--cinematic" role="banner" aria-label="Sengele Ministries hero">
    <div class="hero-inner container-wide">
        <div class="hero-grid">
            <div>
                <div class="hero-kicker">SENGELE MINISTRIES</div>
                <h1 class="hero-title">LA PRIERE ET L'ESPERANCE</h1>
                <p class="hero-sub">Bienvenue à Sengele Ministries un lieu de prière, d'enseignement d'espérance.</p>

                <p>
                    <a class="btn btn-cta me-2" asp-controller="Messages" asp-action="Index">Watch Message</a>
                    <a class="btn btn-outline-cta" asp-controller="Events" asp-action="Index">Join Us</a>
                </p>
            </div>
            
                <div class="message-visual">
                    <img src="~/images/Francis5.jpeg"
                         alt="Sengele Ministries"
                         class="message-media" />
                
            </div>
        </div>
    </div>
</header>

<main>
    <section class="section section--soft">
        <div class="container-wide who-section">
            <div class="who-meta">
                <div class="who-label">QUI SOMMES-NOUS</div>
                <div class="who-accent"></div>
            </div>
            <h2 class="lead-heading">Un ministère de la priere et de l'esperance.</h2>
            <p class="muted who-text">À Sengele Ministries, nous appelons les personnes à la prière persistante, à l'enseignement biblique et à la guérison spirituelle. Nos programmes et messages visent à amener espoir et restauration.</p>
            <p><a asp-controller="About" asp-action="Index" class="link-accent">DÉCOUVRIR NOTRE HISTOIRE →</a></p>
        </div>
    </section>

    <section class="section section--white">
        <div class="container-wide core-values">
            <article class="value-article">
                <div class="value-num">01</div>
                <div class="value-title">ESPOIR</div>
                <div class="value-desc">
                    Romains 12:12 
                    Soyez joyeux dans l'espérance, patients dans la tribulation, persévérants dans la prière.
                    Nous croyons qu'on peut avoir un comportement même dans la persécution, Paul parle de la joie et de la patience dans la tribulation.
                </div>
            </article>
            <article class="value-article">
                <div class="value-num">02</div>
                <div class="value-title">PRIÈRE</div>
                <div class="value-desc">
                    Hébreux 11:3b Bible Amiot & Tamisier :
                     le visible tire son origine de l'invisible.
                     Nous croyons que la plupart des choses visibles tirent leur origine dans l'invisible.
                    Et seule la prière permet à un humain de pénétrer le monde spirituel pour vaincre dans le monde physique.
                </div>
            </article>
        </div>
    </section>
    <section class="section section--soft">
        <div class="container-wide message-card message-card--feature">
            <div class="message-info">
                <div class="label-small muted">DERNIER MESSAGE</div>
                <h3 class="message-title">Message d'espérance</h3>
                <p class="muted message-excerpt">Un court extrait du dernier sermon mettant en avant l'espoir après la tempête.</p>
                <p><a class="btn btn-cta" asp-controller="Messages" asp-action="Index">Watch Message</a></p>
            </div>
            <div class="message-visual">
                <div class="message-visual">
                    <img src="~/images/Francis12.jpeg"
                         alt="Sengele Ministries"
                         class="message-media" />
                </div>
            </div>
        </div>
    </section>

    <section class="section section--white">
        <div class="container-wide text-center">
            <h3 class="section-heading">REJOIGNEZ-NOUS</h3>
            <div class="programs programs--feature">
                <div class="program">
                    <h4>Prière quotidienne</h4>
                    <p class="muted">Rejoignez-nous pour la prière et l'enseignement.</p>
                </div>
                <div class="program">
                    <h4>Services en ligne</h4>
                    <p class="muted">Messages en direct et en replay disponibles en ligne.</p>
                </div>
            </div>
            <p class="mt-3"><a class="text-decoration-none link-accent" asp-controller="Events" asp-action="Index">VIEW ALL EVENTS →</a></p>
        </div>
    </section>

    <section class="section section--dark prayer-section">
        <div class="container-wide prayer-cta">
            <h4 class="muted">NOUS CROYONS EN LA PRIÈRE</h4>
            <h2>Comment pouvons-nous prier pour vous ?</h2>
            <p class="muted">Soumettez une requête, et notre équipe priera pour vous.</p>
            <p><a class="btn btn-cta" asp-controller="Prayer" asp-action="Index">Envoyer une requête de prière</a></p>
        </div>
    </section>

    <!-- I am thinking about my Gallery photo here , but i am not decide yet. -->

</main>

@* Shared interactions (hero rotation + navbar behavior) are in wwwroot/js/site.js *@
