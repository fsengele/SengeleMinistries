@model SengeleMinistries.Models.ForgotPasswordViewModel
@using System.Globalization

@{
    bool isFrench = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "fr";

    ViewData["Title"] = isFrench
        ? "Mot de passe oublié"
        : "Forgot Password";
}

<div class="section">
    <div class="container-wide">

        <div style="max-width:480px;
            margin:0 auto;
            background:var(--sm-white);
            padding:2rem;
            border-radius:8px;
            box-shadow:0 10px 30px rgba(16,16,16,0.06)">

            <h2 class="lead-heading">
                @(isFrench ? "Mot de passe oublié" : "Forgot Password")
            </h2>

            <p class="muted">
                @(isFrench
                    ? "Entrez votre adresse e-mail pour recevoir un lien de réinitialisation de votre mot de passe."
                    : "Enter your email address to receive a password reset link.")
            </p>

            <form asp-controller="Member"
                  asp-action="ForgotPassword"
                  method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label">
                        @(isFrench ? "Adresse e-mail" : "Email")
                    </label>

                    <input asp-for="Email"
                           class="form-control"
                           type="email"
                           autocomplete="email" />

                    <span asp-validation-for="Email"
                          class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-cta">
                    @(isFrench
                        ? "Envoyer le lien de réinitialisation"
                        : "Send Reset Link")
                </button>

                <p class="mt-3 muted">
                    @(isFrench
                        ? "Vous vous souvenez de votre mot de passe ?"
                        : "Remember your password?")

                    <a asp-controller="Member"
                       asp-action="Login"
                       class="link-accent">
                        @(isFrench
                            ? "Retour à la connexion"
                            : "Back to Login")
                    </a>
                </p>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
