@model SengeleMinistries.Models.ResetPasswordViewModel
@using System.Globalization

@{
    bool isFrench = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "fr";
    ViewData["Title"] = isFrench ? "Réinitialiser le mot de passe" : "Reset Password";
}

<div class="section">
    <div class="container-wide">
        <div style="max-width:480px;
            margin:0 auto;
            background:var(--sm-white);
            padding:2rem;
            border-radius:8px;
            box-shadow:0 10px 30px rgba(16,16,16,0.06)">

            <h2 class="lead-heading">
                @(isFrench ? "Réinitialiser le mot de passe" : "Reset Password")
            </h2>

            <p class="muted">
                @(isFrench ? "Entrez votre nouveau mot de passe ci-dessous." : "Enter your new password below.")
            </p>

            <form asp-controller="Member" asp-action="ResetPassword" method="post">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <input asp-for="MemberId" type="hidden" />
                <input asp-for="Token" type="hidden" />

                <div class="mb-3">
                    <label asp-for="NewPassword" class="form-label">
                        @(isFrench ? "Nouveau mot de passe" : "New Password")
                    </label>
                    <input asp-for="NewPassword" class="form-control"
                           type="password" autocomplete="new-password" />
                    <span asp-validation-for="NewPassword" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="ConfirmPassword" class="form-label">
                        @(isFrench ? "Confirmer le mot de passe" : "Confirm Password")
                    </label>
                    <input asp-for="ConfirmPassword" class="form-control"
                           type="password" autocomplete="new-password" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-cta">
                    @(isFrench ? "Réinitialiser le mot de passe" : "Reset Password")
                </button>

                <p class="mt-3 muted">
                    @(isFrench ? "Vous vous souvenez de votre mot de passe ?" : "Remember your password?")
                    <a asp-controller="Member" asp-action="Login" class="link-accent">
                        @(isFrench ? "Retour à la connexion" : "Back to Login")
                    </a>
                </p>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
