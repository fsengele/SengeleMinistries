@{
	ViewData["Title"] = "Messages";
}

<section class="messages-hero">
	<div class="hero-inner container-wide">
		<div class="hero-content">
			<div class="eyebrow">MESSAGES • SERMONS • TEACHINGS</div>
			<h1 class="messages-headline">UNE PAROLE QUI TRANSFORME.</h1>
			<p class="messages-sub">Découvrez les enseignements et les messages du Pasteur Francis Sengele, centrés sur l'espérance, la prière et la Parole de Dieu.</p>
		<p class="hero-ctas">
			<a class="btn btn-cta" href="https://youtube.com/@@francissengele?si=DV-a-vbLbis8i2IN" target="_blank" rel="noopener noreferrer">▶ WATCH MESSAGE</a>
		</p>
		</div>
	</div>
</section>


<section class="section section--soft">
	<div class="container-wide">
		<div class="eyebrow">LATEST MESSAGES</div>
		<h2 class="lead-heading">Recent teachings & sermons</h2>
		<p class="muted">A curated selection of recent messages. This area is prepared to display database-driven message records in the future.</p>

		<div class="programs" style="margin-top:1.5rem">
			<article class="program">
				<h4>Message: Hope After the Storm</h4>
				<p class="muted">An encouraging message about restoration and faith in adversity.</p>
				<p><a class="link-accent" asp-controller="Messages" asp-action="Index">WATCH →</a></p>
			</article>
			<article class="program">
				<h4>Teaching: The Power of Prayer</h4>
				<p class="muted">Practical teaching on persistent prayer and intercession.</p>
				<p><a class="link-accent" asp-controller="Messages" asp-action="Index">WATCH →</a></p>
			</article>
			<article class="program">
				<h4>Devotional: Walking in Hope</h4>
				<p class="muted">Short devotional to encourage your daily walk.</p>
				<p><a class="link-accent" asp-controller="Messages" asp-action="Index">WATCH →</a></p>
			</article>
		</div>
	</div>
</section>

<section class="section section--dark messages-core">
	<div class="container-wide behind-grid">
		<div class="behind-copy">
			<div class="eyebrow">ABOUT THE MESSENGER</div>
			<h2 class="lead-heading">FRANCIS SENGELE</h2>
			<p class="muted">Francis Sengele is a pastor and teacher committed to proclaiming hope through prayer and the Word of God. Learn more about his life and ministry.</p>
			<p><a class="link-accent" asp-controller="About" asp-action="Index">ABOUT FRANCIS →</a></p>
		</div>
		<div class="behind-media" aria-hidden="true" style="background-image:url('/images/Francis5.jpeg');background-size:cover;background-position:center;border-radius:8px;height:280px"></div>
	</div>
</section>
