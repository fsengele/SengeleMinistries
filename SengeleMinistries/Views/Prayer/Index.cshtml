@{
    ViewData["Title"] = "Requête de prière";
}

<!-- =====================================================
     PRAYER HERO
     ===================================================== -->
<section class="sm-prayer-hero">

    <div class="container-wide sm-prayer-hero-inner">

        <div class="sm-prayer-hero-content">

            <p class="sm-prayer-eyebrow">
                SENGELE MINISTRIES • PRIÈRE
            </p>

            <h1>
                NOUS VOULONS
                <span>PRIER AVEC VOUS.</span>
            </h1>

            <p class="sm-prayer-hero-text">
                Quelle que soit la situation que vous traversez,
                vous n'avez pas à la porter seul.
                Partagez votre sujet de prière avec nous.
            </p>

            <div class="sm-prayer-hero-line"></div>

            <p class="sm-prayer-confidential">
                Votre requête sera reçue avec compassion,
                respect et confidentialité.
            </p>

        </div>

    </div>

</section>


<!-- =====================================================
     PRAYER REQUEST SECTION
     ===================================================== -->
<main>

    <section class="sm-prayer-section">

        <div class="container-wide">

            <div class="sm-prayer-section-heading">

                <div>
                    <p class="sm-prayer-small-title">
                        PARTAGEZ VOTRE REQUÊTE
                    </p>

                    <h2>
                        Comment pouvons-nous<br />
                        prier pour vous ?
                    </h2>
                </div>

                <p class="sm-prayer-heading-text">
                    Prenez quelques instants pour nous écrire.
                    Notre équipe de prière prendra le temps de présenter
                    votre requête devant le Seigneur.
                </p>

            </div>


            <div class="sm-prayer-layout">

                <!-- ==========================================
                     FORM
                     ========================================== -->
                <div class="sm-prayer-form-card">

                    <div class="sm-prayer-form-header">

                        <div class="sm-prayer-form-number">
                            01
                        </div>

                        <div>
                            <p class="sm-prayer-form-label">
                                REQUÊTE DE PRIÈRE
                            </p>

                            <h3>
                                Parlez-nous de votre besoin.
                            </h3>
                        </div>

                    </div>


                    <form action="https://formspree.io/f/xgaezoaz"
                          method="POST"
                          class="sm-prayer-form">

                        <!-- NAME -->
                        <div class="sm-prayer-form-row">

                            <div class="sm-prayer-field">
                                <label for="firstName">
                                    PRÉNOM
                                </label>

                                <input id="firstName"
                                       name="FirstName"
                                       type="text"
                                       placeholder="Votre prénom"
                                       required />
                            </div>


                            <div class="sm-prayer-field">
                                <label for="lastName">
                                    NOM
                                </label>

                                <input id="lastName"
                                       name="LastName"
                                       type="text"
                                       placeholder="Votre nom"
                                       required />
                            </div>

                        </div>


                        <!-- CONTACT -->
                        <div class="sm-prayer-form-row">

                            <div class="sm-prayer-field">
                                <label for="phone">
                                    TÉLÉPHONE
                                    <span>OPTIONNEL</span>
                                </label>

                                <input id="phone"
                                       name="Phone"
                                       type="tel"
                                       placeholder="+1 (425) 524-9990" />
                            </div>


                            <div class="sm-prayer-field">
                                <label for="email">
                                    ADRESSE EMAIL
                                </label>

                                <input id="email"
                                       name="Email"
                                       type="email"
                                       placeholder="votre@email.com"
                                       required />
                            </div>

                        </div>


                        <!-- PRAYER -->
                        <div class="sm-prayer-field sm-prayer-message-field">

                            <label for="prayer">
                                VOTRE REQUÊTE
                            </label>

                            <textarea id="prayer"
                                      name="PrayerRequest"
                                      rows="8"
                                      placeholder="Écrivez votre requête de prière ici..."
                                      required></textarea>

                        </div>


                        <!-- PRIVACY -->
                        <div class="sm-prayer-privacy">

                            <div class="sm-prayer-lock">
                                ✦
                            </div>

                            <p>
                                Votre requête est personnelle.
                                Nous la traiterons avec respect
                                et confidentialité.
                            </p>

                        </div>


                        <!-- BUTTON -->
                        <div class="sm-prayer-form-actions">

                            <button type="submit"
                                    class="sm-prayer-submit">

                                ENVOYER MA REQUÊTE
                                <span>→</span>

                            </button>

                        </div>

                    </form>

                </div>


                <!-- ==========================================
                     RIGHT SIDE
                     ========================================== -->
                <aside class="sm-prayer-side">


                    <!-- VERSE -->
                    <div class="sm-prayer-verse-card">

                        <p class="sm-prayer-side-label">
                            LA PAROLE DE DIEU
                        </p>

                        <div class="sm-prayer-quote">
                            “
                        </div>

                        <blockquote>
                            Priez les uns pour les autres,
                            afin que vous soyez guéris.
                        </blockquote>

                        <p class="sm-prayer-reference">
                            JACQUES 5:16
                        </p>

                    </div>


                    <!-- BELIEF -->
                    <div class="sm-prayer-belief-card">

                        <p class="sm-prayer-side-label">
                            NOTRE ENGAGEMENT
                        </p>

                        <h3>
                            Nous croyons<br />
                            en la puissance<br />
                            de la prière.
                        </h3>

                        <div class="sm-prayer-belief-line"></div>

                        <p>
                            Chaque requête reçue représente
                            une personne, une famille et une situation
                            qui mérite notre attention.
                        </p>

                        <p>
                            Notre équipe prie régulièrement
                            pour les requêtes qui nous sont confiées.
                        </p>

                    </div>

                </aside>

            </div>

        </div>

    </section>


    <!-- =====================================================
         BOTTOM ENCOURAGEMENT
         ===================================================== -->
    <section class="sm-prayer-bottom">

        <div class="container-wide sm-prayer-bottom-inner">

            <p class="sm-prayer-small-title">
                ESPÉRANCE • FOI • PRIÈRE
            </p>

            <h2>
                Il y a encore de l'espérance.
            </h2>

            <p>
                Nous ne pouvons peut-être pas connaître tout ce que
                vous traversez, mais nous pouvons nous tenir avec vous
                dans la prière.
            </p>

            <div class="sm-prayer-bottom-line"></div>

            <p class="sm-prayer-bottom-scripture">
                « Invoque-moi, et je te répondrai. »
                <span>— Jérémie 33:3</span>
            </p>

        </div>

    </section>

</main>