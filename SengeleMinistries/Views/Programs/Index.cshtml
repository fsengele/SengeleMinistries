
@{
    var currentCulture = System.Globalization.CultureInfo
        .CurrentUICulture.TwoLetterISOLanguageName;

    var isFrench = currentCulture == "fr";

    ViewData["Title"] = isFrench
        ? "Programmes et formations"
        : "Programs & Training";
}

<section class="programs-page">

    <!-- =========================================
         HERO
         ========================================= -->
    <div class="programs-hero">

        <div class="container container-wide">

            <div class="programs-eyebrow">
                @(isFrench ? "PROGRAMMES ET FORMATIONS" : "PROGRAMS & TRAINING")
            </div>

            <h1 class="programs-heading">
                @if (isFrench)
                {
                    <text>
                        Équiper les disciples<br />
                        pour leur mission et leur service.
                    </text>
                }
                else
                {
                    <text>
                        Equipping disciples<br />
                        for purpose and service.
                    </text>
                }
            </h1>

            <p class="programs-intro">
                @if (isFrench)
                {
                    <text>
                        Plus que transmettre des connaissances, notre désir
                        est de voir des vies transformées.
                        Sengele Ministries offre des enseignements bibliques,
                        des moments de prière, une formation au leadership
                        et une préparation pratique au ministère pour aider
                        les croyants à grandir en Christ et à servir avec un but.
                    </text>
                }
                else
                {
                    <text>
                        More than information, our desire is transformation.
                        Sengele Ministries provides biblical teaching, prayer,
                        leadership development and practical ministry training
                        to help believers grow deeper in Christ and serve with purpose.
                    </text>
                }
            </p>

        </div>

    </div>


    <!-- =========================================
         INTRODUCTION
         ========================================= -->
    <div class="programs-purpose">

        <div class="container container-wide">

            <div class="programs-purpose-grid">

                <div>
                    <span class="programs-small-label">
                        @(isFrench ? "NOTRE OBJECTIF" : "OUR PURPOSE")
                    </span>

                    <h2>
                        @if (isFrench)
                        {
                            <text>
                                Grandir en profondeur.<br />
                                Servir avec plus de force.
                            </text>
                        }
                        else
                        {
                            <text>
                                Growing deeper.<br />
                                Serving stronger.
                            </text>
                        }
                    </h2>
                </div>

                <div class="programs-purpose-text">

                    <p>
                        @(isFrench
                            ? "La croissance spirituelle demande plus que de l'inspiration. Elle demande la vérité, la prière, la discipline et la préparation."
                            : "Spiritual growth requires more than inspiration. It requires truth, prayer, discipline and preparation.")
                    </p>

                    <p>
                        @(isFrench
                            ? "Nos programmes offrent aux croyants des occasions de comprendre la Parole de Dieu, de renforcer leur relation avec Lui, de découvrir leurs capacités de leadership et de se préparer à servir efficacement."
                            : "Our programs create opportunities for believers to understand the Word of God, strengthen their relationship with Him, discover their leadership capacity and become equipped for effective service.")
                    </p>

                </div>

            </div>

        </div>

    </div>


    <!-- =========================================
         PROGRAM 01
         ========================================= -->
    <article class="programs-item">

        <div class="container container-wide">

            <div class="programs-item-grid">

                <div class="programs-number">
                    01
                </div>

                <div class="programs-content">

                    <span class="programs-small-label">
                        @(isFrench ? "FONDEMENT" : "FOUNDATION")
                    </span>

                    <h2>
                        @(isFrench ? "Enseignement biblique" : "Biblical Teaching")
                    </h2>

                    <p class="programs-description">
                        @(isFrench
                            ? "Construisez un fondement solide dans les Écritures grâce à un enseignement biblique approfondi. Notre objectif est de vous aider à aller au-delà de l'écoute de la Parole, pour la comprendre et l'appliquer dans votre vie quotidienne."
                            : "Build a strong foundation in Scripture through thoughtful biblical teaching designed to move beyond simply hearing the Word toward understanding it and applying it to everyday life.")
                    </p>

                    <div class="programs-details">

                        <div>
                            <strong>
                                @(isFrench ? "Étudier la Parole" : "Study the Word")
                            </strong>

                            <p>
                                @(isFrench
                                    ? "Explorez les Écritures avec plus de profondeur, de contexte et de compréhension."
                                    : "Explore Scripture with greater depth, context and understanding.")
                            </p>
                        </div>

                        <div>
                            <strong>
                                @(isFrench ? "Vivre la Parole" : "Live the Word")
                            </strong>

                            <p>
                                @(isFrench
                                    ? "Appliquez la vérité biblique à vos décisions, vos relations, votre caractère et votre ministère."
                                    : "Connect biblical truth with decisions, relationships, character and ministry.")
                            </p>
                        </div>

                    </div>

                    <blockquote class="programs-scripture">
                        @if (isFrench)
                        {
                            <text>
                                « Ta parole est une lampe à mes pieds,
                                et une lumière sur mon sentier. »
                                <span>Psaume 119:105</span>
                            </text>
                        }
                        else
                        {
                            <text>
                                “Your word is a lamp for my feet,
                                a light on my path.”
                                <span>Psalm 119:105</span>
                            </text>
                        }
                    </blockquote>

                </div>

            </div>

        </div>

    </article>


    <!-- =========================================
         PROGRAM 02
         ========================================= -->
    <article class="programs-item programs-item--dark">

        <div class="container container-wide">

            <div class="programs-item-grid">

                <div class="programs-number">
                    02
                </div>

                <div class="programs-content">

                    <span class="programs-small-label">
                        @(isFrench ? "FORMATION SPIRITUELLE" : "SPIRITUAL FORMATION")
                    </span>

                    <h2>
                        @if (isFrench)
                        {
                            <text>
                                Prière et<br />
                                croissance spirituelle
                            </text>
                        }
                        else
                        {
                            <text>
                                Prayer &amp;<br />
                                Spiritual Growth
                            </text>
                        }
                    </h2>

                    <p class="programs-description">
                        @(isFrench
                            ? "Développez une vie de prière plus profonde et une communion plus intime avec Dieu. Ces rencontres et ressources sont conçues pour renforcer la foi, la discipline spirituelle et la dépendance envers Dieu."
                            : "Develop a deeper life of prayer and communion with God. These gatherings and resources are designed to strengthen faith, spiritual discipline and dependence upon God.")
                    </p>

                    <div class="programs-details">

                        <div>
                            <strong>
                                @(isFrench ? "Grandir dans la prière" : "Grow in Prayer")
                            </strong>

                            <p>
                                @(isFrench
                                    ? "Développez la régularité, la confiance et la profondeur dans votre vie personnelle de prière."
                                    : "Develop consistency, confidence and depth in your personal prayer life.")
                            </p>
                        </div>

                        <div>
                            <strong>
                                @(isFrench ? "Grandir spirituellement" : "Grow Spiritually")
                            </strong>

                            <p>
                                @(isFrench
                                    ? "Adoptez des habitudes qui renforcent votre marche avec Dieu au-delà des rencontres à l'église."
                                    : "Create habits that strengthen your walk with God beyond church gatherings.")
                            </p>
                        </div>

                    </div>

                    <blockquote class="programs-scripture">
                        @if (isFrench)
                        {
                            <text>
                                « Persévérez dans la prière,
                                veillez-y avec actions de grâces. »
                                <span>Colossiens 4:2</span>
                            </text>
                        }
                        else
                        {
                            <text>
                                “Devote yourselves to prayer,
                                being watchful and thankful.”
                                <span>Colossians 4:2</span>
                            </text>
                        }
                    </blockquote>

                </div>

            </div>

        </div>

    </article>


    <!-- =========================================
         PROGRAM 03
         ========================================= -->
    <article class="programs-item">

        <div class="container container-wide">

            <div class="programs-item-grid">

                <div class="programs-number">
                    03
                </div>

                <div class="programs-content">

                    <span class="programs-small-label">
                        @(isFrench ? "LEADERSHIP" : "LEADERSHIP")
                    </span>

                    <h2>
                        @(isFrench ? "Développement du leadership" : "Leadership Development")
                    </h2>

                    <p class="programs-description">
                        @(isFrench
                            ? "Le leadership est plus qu'une position. C'est une question de caractère, de responsabilité et de service. Notre formation prépare les futurs responsables à conduire les autres avec sagesse, humilité et vision."
                            : "Leadership is more than a position. It is character, responsibility and service. Our leadership development training prepares emerging leaders to lead people with wisdom, humility and vision.")
                    </p>

                    <div class="programs-details">

                        <div>
                            <strong>
                                @(isFrench ? "Développer le caractère" : "Develop Character")
                            </strong>

                            <p>
                                @(isFrench
                                    ? "Renforcez votre intégrité, votre responsabilité, votre discipline et votre esprit de service."
                                    : "Strengthen integrity, responsibility, discipline and servant leadership.")
                            </p>
                        </div>

                        <div>
                            <strong>
                                @(isFrench ? "Développer les compétences" : "Develop Capacity")
                            </strong>

                            <p>
                                @(isFrench
                                    ? "Apprenez des compétences pratiques en communication, en travail d'équipe et en direction du ministère."
                                    : "Learn practical skills for communication, teamwork and ministry leadership.")
                            </p>
                        </div>

                    </div>

                    <blockquote class="programs-scripture">
                        @if (isFrench)
                        {
                            <text>
                                « Quiconque veut être grand parmi vous,
                                qu'il soit votre serviteur. »
                                <span>Matthieu 20:26</span>
                            </text>
                        }
                        else
                        {
                            <text>
                                “Whoever wants to become great among you
                                must be your servant.”
                                <span>Matthew 20:26</span>
                            </text>
                        }
                    </blockquote>

                </div>

            </div>

        </div>

    </article>


    <!-- =========================================
         PROGRAM 04
         ========================================= -->
    <article class="programs-item programs-item--gold">

        <div class="container container-wide">

            <div class="programs-item-grid">

                <div class="programs-number">
                    04
                </div>

                <div class="programs-content">

                    <span class="programs-small-label">
                        @(isFrench ? "SERVICE PRATIQUE" : "PRACTICAL SERVICE")
                    </span>

                    <h2>
                        @(isFrench ? "Formation au ministère" : "Ministry Training")
                    </h2>

                    <p class="programs-description">
                        @(isFrench
                            ? "Passez de l'apprentissage au service. La formation au ministère offre aux participants des occasions pratiques de développer la discipline, l'excellence et le cœur nécessaires pour servir les autres efficacement."
                            : "Move from learning to serving. Ministry Training gives participants practical opportunities to develop the discipline, excellence and heart required to serve people effectively.")
                    </p>

                    <div class="programs-details">

                        <div>
                            <strong>
                                @(isFrench ? "Apprendre en servant" : "Learn by Serving")
                            </strong>

                            <p>
                                @(isFrench
                                    ? "Acquérez une expérience pratique dans le ministère à travers les événements, l'accueil et les activités d'évangélisation."
                                    : "Gain practical ministry experience through events, hospitality and outreach.")
                            </p>
                        </div>

                        <div>
                            <strong>
                                @(isFrench ? "Servir avec excellence" : "Serve with Excellence")
                            </strong>

                            <p>
                                @(isFrench
                                    ? "Apprenez la préparation, le travail d'équipe et la responsabilité dans des situations réelles de ministère."
                                    : "Learn preparation, teamwork and responsibility in real ministry environments.")
                            </p>
                        </div>

                    </div>

                    <blockquote class="programs-scripture">
                        @if (isFrench)
                        {
                            <text>
                                « Que chacun de vous mette au service des autres
                                le don qu'il a reçu. »
                                <span>1 Pierre 4:10</span>
                            </text>
                        }
                        else
                        {
                            <text>
                                “Each of you should use whatever gift
                                you have received to serve others.”
                                <span>1 Peter 4:10</span>
                            </text>
                        }
                    </blockquote>

                </div>

            </div>

        </div>

    </article>


    <!-- =========================================
         FINAL CALL TO ACTION
         ========================================= -->
    <section class="programs-cta">

        <div class="container container-wide">

            <span class="programs-small-label">
                @(isFrench ? "PASSEZ À L'ÉTAPE SUIVANTE" : "TAKE THE NEXT STEP")
            </span>

            <h2>
                @if (isFrench)
                {
                    <text>
                        Grandissez dans la foi.<br />
                        Préparez-vous à servir.
                    </text>
                }
                else
                {
                    <text>
                        Grow in faith.<br />
                        Prepare to serve.
                    </text>
                }
            </h2>

            <p>
                @(isFrench
                    ? "Que vous commenciez votre parcours ou que vous vous prépariez à de plus grandes responsabilités dans le ministère, il existe toujours une nouvelle étape de croissance."
                    : "Whether you are beginning your journey or preparing for greater responsibility in ministry, there is always another level of growth.")
            </p>

            <a asp-controller="Contact"
               asp-action="Index"
               class="programs-cta-button">
                @(isFrench ? "CONTACTEZ-NOUS" : "CONNECT WITH US")
            </a>

        </div>

    </section>

</section>
