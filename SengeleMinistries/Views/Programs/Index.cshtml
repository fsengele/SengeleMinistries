@{
    ViewData["Title"] = "Programs & Training";
}

<section class="programs-page">

    <!-- =========================================
         HERO
         ========================================= -->
    <div class="programs-hero">

        <div class="container container-wide">

            <div class="programs-eyebrow">
                PROGRAMS &amp; TRAINING
            </div>

            <h1 class="programs-heading">
                Equipping disciples<br />
                for purpose and service.
            </h1>

            <p class="programs-intro">
                More than information, our desire is transformation.
                Sengele Ministries provides biblical teaching, prayer,
                leadership development and practical ministry training
                to help believers grow deeper in Christ and serve with purpose.
            </p>

        </div>

    </div>


    <!-- =========================================
         INTRODUCTION
         ========================================= -->
    <div class="programs-purpose">

        <div class="container container-wide">

            <div class="programs-purpose-grid">

                <div>
                    <span class="programs-small-label">
                        OUR PURPOSE
                    </span>

                    <h2>
                        Growing deeper.<br />
                        Serving stronger.
                    </h2>
                </div>

                <div class="programs-purpose-text">

                    <p>
                        Spiritual growth requires more than inspiration.
                        It requires truth, prayer, discipline and preparation.
                    </p>

                    <p>
                        Our programs create opportunities for believers
                        to understand the Word of God, strengthen their
                        relationship with Him, discover their leadership
                        capacity and become equipped for effective service.
                    </p>

                </div>

            </div>

        </div>

    </div>


    <!-- =========================================
         PROGRAM 01
         ========================================= -->
    <article class="programs-item">

        <div class="container container-wide">

            <div class="programs-item-grid">

                <div class="programs-number">
                    01
                </div>

                <div class="programs-content">

                    <span class="programs-small-label">
                        FOUNDATION
                    </span>

                    <h2>
                        Biblical Teaching
                    </h2>

                    <p class="programs-description">
                        Build a strong foundation in Scripture through
                        thoughtful biblical teaching designed to move
                        beyond simply hearing the Word toward understanding
                        it and applying it to everyday life.
                    </p>

                    <div class="programs-details">

                        <div>
                            <strong>Study the Word</strong>

                            <p>
                                Explore Scripture with greater depth,
                                context and understanding.
                            </p>
                        </div>

                        <div>
                            <strong>Live the Word</strong>

                            <p>
                                Connect biblical truth with decisions,
                                relationships, character and ministry.
                            </p>
                        </div>

                    </div>

                    <blockquote class="programs-scripture">
                        “Your word is a lamp for my feet,
                        a light on my path.”
                        <span>Psalm 119:105</span>
                    </blockquote>

                </div>

            </div>

        </div>

    </article>


    <!-- =========================================
         PROGRAM 02
         ========================================= -->
    <article class="programs-item programs-item--dark">

        <div class="container container-wide">

            <div class="programs-item-grid">

                <div class="programs-number">
                    02
                </div>

                <div class="programs-content">

                    <span class="programs-small-label">
                        SPIRITUAL FORMATION
                    </span>

                    <h2>
                        Prayer &amp;<br />
                        Spiritual Growth
                    </h2>

                    <p class="programs-description">
                        Develop a deeper life of prayer and communion
                        with God. These gatherings and resources are
                        designed to strengthen faith, spiritual discipline
                        and dependence upon God.
                    </p>

                    <div class="programs-details">

                        <div>
                            <strong>Grow in Prayer</strong>

                            <p>
                                Develop consistency, confidence and depth
                                in your personal prayer life.
                            </p>
                        </div>

                        <div>
                            <strong>Grow Spiritually</strong>

                            <p>
                                Create habits that strengthen your walk
                                with God beyond church gatherings.
                            </p>
                        </div>

                    </div>

                    <blockquote class="programs-scripture">
                        “Devote yourselves to prayer,
                        being watchful and thankful.”
                        <span>Colossians 4:2</span>
                    </blockquote>

                </div>

            </div>

        </div>

    </article>


    <!-- =========================================
         PROGRAM 03
         ========================================= -->
    <article class="programs-item">

        <div class="container container-wide">

            <div class="programs-item-grid">

                <div class="programs-number">
                    03
                </div>

                <div class="programs-content">

                    <span class="programs-small-label">
                        LEADERSHIP
                    </span>

                    <h2>
                        Leadership Development
                    </h2>

                    <p class="programs-description">
                        Leadership is more than a position. It is character,
                        responsibility and service. Our leadership development
                        training prepares emerging leaders to lead people
                        with wisdom, humility and vision.
                    </p>

                    <div class="programs-details">

                        <div>
                            <strong>Develop Character</strong>

                            <p>
                                Strengthen integrity, responsibility,
                                discipline and servant leadership.
                            </p>
                        </div>

                        <div>
                            <strong>Develop Capacity</strong>

                            <p>
                                Learn practical skills for communication,
                                teamwork and ministry leadership.
                            </p>
                        </div>

                    </div>

                    <blockquote class="programs-scripture">
                        “Whoever wants to become great among you
                        must be your servant.”
                        <span>Matthew 20:26</span>
                    </blockquote>

                </div>

            </div>

        </div>

    </article>


    <!-- =========================================
         PROGRAM 04
         ========================================= -->
    <article class="programs-item programs-item--gold">

        <div class="container container-wide">

            <div class="programs-item-grid">

                <div class="programs-number">
                    04
                </div>

                <div class="programs-content">

                    <span class="programs-small-label">
                        PRACTICAL SERVICE
                    </span>

                    <h2>
                        Ministry Training
                    </h2>

                    <p class="programs-description">
                        Move from learning to serving. Ministry Training
                        gives participants practical opportunities to
                        develop the discipline, excellence and heart
                        required to serve people effectively.
                    </p>

                    <div class="programs-details">

                        <div>
                            <strong>Learn by Serving</strong>

                            <p>
                                Gain practical ministry experience through
                                events, hospitality and outreach.
                            </p>
                        </div>

                        <div>
                            <strong>Serve with Excellence</strong>

                            <p>
                                Learn preparation, teamwork and responsibility
                                in real ministry environments.
                            </p>
                        </div>

                    </div>

                    <blockquote class="programs-scripture">
                        “Each of you should use whatever gift
                        you have received to serve others.”
                        <span>1 Peter 4:10</span>
                    </blockquote>

                </div>

            </div>

        </div>

    </article>


    <!-- =========================================
         FINAL CALL TO ACTION
         ========================================= -->
    <section class="programs-cta">

        <div class="container container-wide">

            <span class="programs-small-label">
                TAKE THE NEXT STEP
            </span>

            <h2>
                Grow in faith.<br />
                Prepare to serve.
            </h2>

            <p>
                Whether you are beginning your journey or preparing
                for greater responsibility in ministry, there is always
                another level of growth.
            </p>

            <a asp-controller="Contact"
               asp-action="Index"
               class="programs-cta-button">
                CONNECT WITH US
            </a>

        </div>

    </section>

</section>