@{
	ViewData["Title"] = "Programs & Training";
}

<section class="section section--white">
	<div class="container container-wide">
		<div class="who-label">Programs & Training</div>
		<h1 class="lead-heading">Equipping disciples through teaching and training</h1>
		<p class="muted">Our programs are designed to deepen your faith, strengthen prayer life, and prepare leaders for service.</p>

		<div class="section mt-4">
			<div class="core-values">
				<article class="value-article">
					<div class="value-num">1</div>
					<h3 class="value-title">Biblical Teaching</h3>
					<p class="value-desc muted">In-depth courses and study groups focused on Scripture, hermeneutics, and practical application for life and ministry.</p>
				</article>

				<article class="value-article">
					<div class="value-num">2</div>
					<h3 class="value-title">Prayer & Spiritual Growth</h3>
					<p class="value-desc muted">Guided prayer gatherings, retreats, and resources designed to deepen your walk with God.</p>
				</article>

				<article class="value-article">
					<div class="value-num">3</div>
					<h3 class="value-title">Leadership Development</h3>
					<p class="value-desc muted">Training for emerging leaders, team development, and practical leadership skills for ministry contexts.</p>
				</article>

				<article class="value-article">
					<div class="value-num">4</div>
					<h3 class="value-title">Ministry Training</h3>
					<p class="value-desc muted">Hands-on ministry practicum for event support, hospitality, and outreach preparation.</p>
				</article>
			</div>
		</div>
	</div>
</section>
