
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Sengele Ministries</title>
    <meta name="description" content="Sengele Ministries - Hope, Prayer and The Word" />

    <!-- ========================================== -->
    <!-- PWA - SENGELE MINISTRIES MOBILE APP -->
    <!-- ========================================== -->

    <link rel="manifest" href="~/manifest.json" />
    <meta name="theme-color" content="#111111" />

    <!-- iPhone / iPad -->
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black" />
    <meta name="apple-mobile-web-app-title" content="Sengele Ministries" />
    <link rel="apple-touch-icon" href="~/images/icons/icon-192.png" />

    <!-- ========================================== -->
    <!-- GOOGLE ANALYTICS - SENGELE MINISTRIES -->
    <!-- ========================================== -->

    <script async src="https://www.googletagmanager.com/gtag/js?id=G-BJ5LK350KR"></script>
    <script>
            window.dataLayer = window.dataLayer || [];

            function gtag() {
                dataLayer.push(arguments);
            }

            gtag('js', new Date());
            gtag('config', 'G-BJ5LK350KR');
    </script>

    <!-- End Google Analytics -->
    <!-- CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

</head>

<body class="site-body">

    @* Navigation (sticky, transparent over hero) *@
    @await Html.PartialAsync("_Navigation")

    <main class="site-main">
        @RenderBody()
    </main>

    @* Premium structured footer (redesigned) *@
    <footer class="site-footer">
        <div class="container py-5">
            <div class="row gy-4">

                <div class="col-md-4">
                    <a class="d-flex align-items-start footer-brand-link"
                       asp-controller="Home"
                       asp-action="Index">

                        <div class="brand-mark me-3" aria-hidden="true">
                            <span class="brand-monogram">SM</span>
                        </div>

                        <div class="brand-text d-none d-md-block">
                            <div class="brand-line brand-name">SENGELE</div>
                            <div class="brand-line brand-sub">MINISTRIES</div>
                        </div>

                        <div class="brand-text d-block d-md-none">
                            <div class="brand-line brand-name-small">
                                SENGELE MINISTRIES
                            </div>
                        </div>
                    </a>

                    <p class="mt-3 text-muted-quiet small-uppercase">
                        HOPE • PRAYER • THE WORD
                    </p>

                    <p class="mt-2 muted footer-statement">
                        Bringing hope through prayer and the Word of God.
                    </p>
                </div>

                <div class="col-6 col-md-2">
                    <h6 class="footer-heading">Ministry</h6>

                    <ul class="list-unstyled footer-list">
                        <li>
                            <a asp-controller="About" asp-action="Index">
                                About
                            </a>
                        </li>
                        <li>
                            <a asp-controller="Messages" asp-action="Index">
                                Messages
                            </a>
                        </li>
                        <li>
                            <a asp-controller="Events" asp-action="Index">
                                Events
                            </a>
                        </li>
                        <li>
                            <a asp-controller="Prayer" asp-action="Index">
                                Prayer
                            </a>
                        </li>
                    </ul>
                </div>

                <div class="col-6 col-md-2">
                    <h6 class="footer-heading">Connect</h6>

                    <ul class="list-unstyled footer-list">
                        <li>
                            <a asp-controller="Contact" asp-action="Index">
                                Contact
                            </a>
                        </li>
                        <li>
                            <a asp-controller="Member" asp-action="Login">
                                My Account
                            </a>
                        </li>
                        <li>
                            <a asp-controller="Home" asp-action="Donate">
                                Give
                            </a>
                        </li>
                        <li>
                            <a class="btn btn-outline-cta btn-sm px-2 py-1 mt-2"
                               href="https://www.youtube.com/@@SengeleMinistries"
                               target="_blank"
                               rel="noopener">
                                Watch Now
                            </a>
                        </li>
                    </ul>
                </div>

                <div class="col-12 col-md-4">
                    <h6 class="footer-heading">Follow</h6>

                    <ul class="list-unstyled d-flex gap-3 footer-social">
                        <li>
                            <a class="footer-yt"
                               href="https://www.youtube.com/@@SengeleMinistries"
                               target="_blank"
                               rel="noopener">
                                YouTube
                            </a>
                        </li>

                        <li>
                            <a href="#" title="Facebook - official URL required">
                                Facebook
                            </a>
                        </li>

                        <li>
                            <a href="#" title="Instagram - official URL required">
                                Instagram
                            </a>
                        </li>
                    </ul>

                    <p class="mt-3 muted small">
                        Support our work by giving or sharing resources with your community.
                    </p>
                </div>
            </div>

            <div class="footer-bottom-divider mt-4"></div>

            <div class="row pt-3 align-items-center">
                <div class="col-6 text-start small muted">
                    © 2026 Sengele Ministries
                </div>

                <div class="col-6 text-end small muted d-none d-md-block">
                    HOPE • PRAYER • THE WORD
                </div>

                <div class="col-12 text-center small muted d-block d-md-none mt-2">
                    HOPE • PRAYER • THE WORD
                </div>
            </div>
        </div>
    </footer>

    <!-- JavaScript -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <!-- ========================================== -->
    <!-- PWA SERVICE WORKER - SENGELE MINISTRIES -->
    <!-- ========================================== -->

    <script>
            if ('serviceWorker' in navigator) {
                window.addEventListener('load', function () {

                    navigator.serviceWorker.register('/service-worker.js')
                        .then(function (registration) {
                            console.log(
                                'Sengele Ministries PWA registered:',
                                registration.scope
                            );
                        })
                        .catch(function (error) {
                            console.error(
                                'PWA registration failed:',
                                error
                            );
                        });

                });
            }
    </script>

    <!-- End PWA Service Worker -->
    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
