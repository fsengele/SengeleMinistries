
@using System.Globalization

@{
    var currentCulture = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    var isFrench = currentCulture == "fr";

    var pageTitle = ViewData["Title"]?.ToString();

    var fullTitle = string.IsNullOrWhiteSpace(pageTitle)
        ? "Sengele Ministries"
        : pageTitle + " - Sengele Ministries";

    var defaultDescription = isFrench
        ? "Sengele Ministries partage l'espérance à travers la prière, la Parole de Dieu, les enseignements bibliques et les événements."
        : "Sengele Ministries shares hope through prayer, the Word of God, biblical teachings and community events.";

    var metaDescription = ViewData["MetaDescription"]?.ToString();

    if (string.IsNullOrWhiteSpace(metaDescription))
    {
        metaDescription = defaultDescription;
    }

    // ==========================================
    // SEO - CANONICAL URL
    // ==========================================

    var requestPath = Context.Request.Path.Value ?? "/";

    var canonicalPath = requestPath.TrimEnd('/');

    if (string.IsNullOrWhiteSpace(canonicalPath))
    {
        canonicalPath = "/";
    }

    var canonicalUrl =
        "https://www.sengeleministries.com" + canonicalPath;

    // ==========================================
    // SEO - PRIVATE PAGES
    // ==========================================

    var isPrivatePage =
        requestPath.StartsWith("/Admin", StringComparison.OrdinalIgnoreCase) ||
        requestPath.StartsWith("/Member", StringComparison.OrdinalIgnoreCase) ||
        requestPath.StartsWith("/Checkout", StringComparison.OrdinalIgnoreCase) ||
        requestPath.StartsWith("/Cart", StringComparison.OrdinalIgnoreCase);

    var robotsContent = isPrivatePage
        ? "noindex, nofollow"
        : "index, follow";

    // ==========================================
    // SOCIAL MEDIA IMAGE
    // ==========================================

    var socialImageUrl =
        "https://www.sengeleministries.com/images/icons/icon-512.png";

    var socialLocale = isFrench ? "fr_FR" : "en_US";
}

<!DOCTYPE html>
<html lang="@currentCulture">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <!-- ==========================================
         SEO - SENGELE MINISTRIES
         ========================================== -->

    <title>@fullTitle</title>

    <meta name="description"
          content="@metaDescription" />

    <meta name="robots"
          content="@robotsContent" />

    <link rel="canonical"
          href="@canonicalUrl" />

    <!-- ==========================================
         OPEN GRAPH - FACEBOOK / WHATSAPP
         ========================================== -->

    <meta property="og:type"
          content="website" />

    <meta property="og:site_name"
          content="Sengele Ministries" />

    <meta property="og:title"
          content="@fullTitle" />

    <meta property="og:description"
          content="@metaDescription" />

    <meta property="og:url"
          content="@canonicalUrl" />

    <meta property="og:image"
          content="@socialImageUrl" />

    <meta property="og:image:width"
          content="512" />

    <meta property="og:image:height"
          content="512" />

    <meta property="og:image:alt"
          content="Sengele Ministries official logo" />

    <meta property="og:locale"
          content="@socialLocale" />

    <!-- ==========================================
         TWITTER / X
         ========================================== -->

    <meta name="twitter:card"
          content="summary" />

    <meta name="twitter:title"
          content="@fullTitle" />

    <meta name="twitter:description"
          content="@metaDescription" />

    <meta name="twitter:image"
          content="@socialImageUrl" />

    <meta name="twitter:image:alt"
          content="Sengele Ministries official logo" />

    <!-- ==========================================
         PWA - SENGELE MINISTRIES MOBILE APP
         ========================================== -->

    <link rel="manifest"
          href="~/manifest.json" />

    <meta name="theme-color"
          content="#111111" />

    <!-- iPhone / iPad -->

    <meta name="apple-mobile-web-app-capable"
          content="yes" />

    <meta name="apple-mobile-web-app-status-bar-style"
          content="black" />

    <meta name="apple-mobile-web-app-title"
          content="Sengele Ministries" />

    <link rel="apple-touch-icon"
          href="~/images/icons/icon-192.png" />

    <!-- ==========================================
         GOOGLE ANALYTICS - SENGELE MINISTRIES
         ========================================== -->

    <script async
            src="https://www.googletagmanager.com/gtag/js?id=G-BJ5LK350KR">
    </script>

    <script>
        window.dataLayer = window.dataLayer || [];

        function gtag() {
            dataLayer.push(arguments);
        }

        gtag('js', new Date());

        gtag('config', 'G-BJ5LK350KR');
    </script>

    <!-- End Google Analytics -->

    <!-- ==========================================
         CSS
         ========================================== -->

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

</head>

<body class="site-body">

    @* Navigation (sticky, transparent over hero) *@

    @await Html.PartialAsync("_Navigation")

    <main class="site-main">

        @RenderBody()

    </main>

    @* Premium structured footer (redesigned) *@

    <footer class="site-footer">

        <div class="container py-5">

            <div class="row gy-4">

                <!-- ==========================================
                     BRAND
                     ========================================== -->

                <div class="col-md-4">

                    <a class="d-flex align-items-start footer-brand-link"
                       asp-controller="Home"
                       asp-action="Index">

                        <div class="brand-mark me-3"
                             aria-hidden="true">

                            <span class="brand-monogram">SM</span>

                        </div>

                        <div class="brand-text d-none d-md-block">

                            <div class="brand-line brand-name">
                                SENGELE
                            </div>

                            <div class="brand-line brand-sub">
                                MINISTRIES
                            </div>

                        </div>

                        <div class="brand-text d-block d-md-none">

                            <div class="brand-line brand-name-small">
                                SENGELE MINISTRIES
                            </div>

                        </div>

                    </a>

                    <p class="mt-3 text-muted-quiet small-uppercase">
                        HOPE • PRAYER • THE WORD
                    </p>

                    <p class="mt-2 muted footer-statement">
                        Bringing hope through prayer and the Word of God.
                    </p>

                </div>

                <!-- ==========================================
                     MINISTRY
                     ========================================== -->

                <div class="col-6 col-md-2">

                    <h6 class="footer-heading">
                        Ministry
                    </h6>

                    <ul class="list-unstyled footer-list">

                        <li>
                            <a asp-controller="About"
                               asp-action="Index">
                                About
                            </a>
                        </li>

                        <li>
                            <a asp-controller="Messages"
                               asp-action="Index">
                                Messages
                            </a>
                        </li>

                        <li>
                            <a asp-controller="Events"
                               asp-action="Index">
                                Events
                            </a>
                        </li>

                        <li>
                            <a asp-controller="Prayer"
                               asp-action="Index">
                                Prayer
                            </a>
                        </li>

                    </ul>

                </div>

                <!-- ==========================================
                     CONNECT
                     ========================================== -->

                <div class="col-6 col-md-2">

                    <h6 class="footer-heading">
                        Connect
                    </h6>

                    <ul class="list-unstyled footer-list">

                        <li>
                            <a asp-controller="Contact"
                               asp-action="Index">
                                Contact
                            </a>
                        </li>

                        <li>
                            <a asp-controller="Member"
                               asp-action="Login">
                                My Account
                            </a>
                        </li>

                        <li>
                            <a asp-controller="Home"
                               asp-action="Donate">
                                Give
                            </a>
                        </li>

                        <li>

                            @* Official announcement video *@

                            <a class="btn btn-outline-cta btn-sm px-2 py-1 mt-2"
                               href="https://www.youtube.com/watch?v=wTcNUOmCoJ8"
                               target="_blank"
                               rel="noopener noreferrer">

                                Watch Now

                            </a>

                        </li>

                    </ul>

                </div>

                <!-- ==========================================
                     FOLLOW
                     ========================================== -->

                <div class="col-12 col-md-4">

                    <h6 class="footer-heading">
                        Follow
                    </h6>

                    <ul class="list-unstyled d-flex gap-3 footer-social">

                        <li>

                            @* YouTube announcement video *@

                            <a class="footer-yt"
                               href="https://www.youtube.com/watch?v=wTcNUOmCoJ8"
                               target="_blank"
                               rel="noopener noreferrer">

                                YouTube

                            </a>

                        </li>

                        <li>

                            <a href="#"
                               title="Facebook - official URL required">

                                Facebook

                            </a>

                        </li>

                        <li>

                            <a href="#"
                               title="Instagram - official URL required">

                                Instagram

                            </a>

                        </li>

                    </ul>

                    <p class="mt-3 muted small">

                        Support our work by giving or sharing
                        resources with your community.

                    </p>

                </div>

            </div>

            <div class="footer-bottom-divider mt-4"></div>

            <div class="row pt-3 align-items-center">

                <div class="col-6 text-start small muted">

                    © 2026 Sengele Ministries

                </div>

                <div class="col-6 text-end small muted d-none d-md-block">

                    HOPE • PRAYER • THE WORD

                </div>

                <div class="col-12 text-center small muted d-block d-md-none mt-2">

                    HOPE • PRAYER • THE WORD

                </div>

            </div>

        </div>

    </footer>

    <!-- ==========================================
         JAVASCRIPT
         ========================================== -->

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    <!-- ==========================================
         PWA SERVICE WORKER
         ========================================== -->

    <script>
        if ('serviceWorker' in navigator) {

            window.addEventListener('load', function () {

                navigator.serviceWorker.register('/service-worker.js')

                    .then(function (registration) {

                        console.log(
                            'Sengele Ministries PWA registered:',
                            registration.scope
                        );

                    })

                    .catch(function (error) {

                        console.error(
                            'PWA registration failed:',
                            error
                        );

                    });

            });

        }
    </script>

    <!-- End PWA Service Worker -->

    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>
