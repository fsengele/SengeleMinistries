<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Sengele Ministries</title>
    <meta name="description" content="Sengele Ministries - Hope, Prayer and The Word" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="site-body">
    @* Navigation (sticky, transparent over hero) *@
    @await Html.PartialAsync("_Navigation")

    <main class="site-main">
        @RenderBody()
    </main>

    @* Premium structured footer *@
    <footer class="site-footer">
        <div class="container py-5">
            <div class="row">
                <div class="col-md-3 mb-4">
                    <h5 class="footer-brand">Sengele Ministries</h5>
                    <p class="muted">Hope • Prayer • The Word</p>
                </div>

                <div class="col-md-2 mb-3">
                    <h6>Ministry</h6>
                    <ul class="list-unstyled">
                        <li><a asp-controller="About" asp-action="Index">About</a></li>
                        <li><a asp-controller="Messages" asp-action="Index">Messages</a></li>
                        <li><a asp-controller="Events" asp-action="Index">Events</a></li>
                        <li><a asp-controller="Prayer" asp-action="Index">Prayer</a></li>
                    </ul>
                </div>

                <div class="col-md-2 mb-3">
                    <h6>Connect</h6>
                    <ul class="list-unstyled">
                        <li><a asp-controller="Member" asp-action="Login">My Account</a></li>
                        <li><span class="muted">Serve With Us <small class="muted">(Coming soon)</small></span></li>
                        <li><span class="muted">Programs <small class="muted">(Coming soon)</small></span></li>
                        <li><a asp-controller="Contact" asp-action="Index">Contact</a></li>
                    </ul>
                </div>

                <div class="col-md-2 mb-3">
                    <h6>Resources</h6>
                    <ul class="list-unstyled">
                        <li><span class="muted">Books &amp; Bibles <small class="muted">(Coming soon)</small></span></li>
                        <li><span class="muted">Teachings &amp; Resources <small class="muted">(Coming soon)</small></span></li>
                        <li><span class="muted">Event Collections <small class="muted">(Coming soon)</small></span></li>
                        <li><span class="muted">Apparel <small class="muted">(Coming soon)</small></span></li>
                    </ul>
                </div>

                <div class="col-md-3 mb-3">
                    <h6>Support</h6>
                    <p><a class="btn btn-cta btn-sm" asp-controller="Home" asp-action="Donate">Donate</a></p>
                    <h6 class="mt-3">Follow</h6>
                    <ul class="list-unstyled d-flex gap-3">
                        <li><a class="footer-yt" href="https://youtube.com/@@francissengele?si=DV-a-vbLbis8i2IN" target="_blank" rel="noopener">YouTube</a></li>
                        <li><a href="#" aria-disabled="true" title="Facebook - official URL required">Facebook</a></li>
                        <li><a href="#" aria-disabled="true" title="Instagram - official URL required">Instagram</a></li>
                    </ul>
                </div>
            </div>

            <div class="row mt-4">
                <div class="col-12 text-center muted">© 2026 Sengele Ministries</div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
