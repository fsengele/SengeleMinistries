@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> Localizer

@* Premium responsive navigation for Sengele Ministries *@

<nav id="mainNavbar" class="navbar navbar-expand-lg fixed-top">

    <div class="container-fluid px-3 px-lg-4">

        @* =====================================================
           LOGO / BRAND
           ===================================================== *@

        <a class="navbar-brand d-flex align-items-center"
           asp-area=""
           asp-controller="Home"
           asp-action="Index">

            <div class="brand-mark" aria-hidden="true">
                <span class="brand-monogram">SM</span>
            </div>

            <div class="brand-text ms-2 d-none d-lg-block">
                <div class="brand-line brand-name">
                    SENGELE
                </div>

                <div class="brand-line brand-sub">
                    MINISTRIES
                </div>
            </div>

            <div class="brand-text ms-2 d-lg-none">
                <div class="brand-line brand-name-small">
                    SENGELE MINISTRIES
                </div>
            </div>

        </a>


        @* =====================================================
           MOBILE BUTTON
           ===================================================== *@

        <button class="navbar-toggler"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#mainNav"
                aria-controls="mainNav"
                aria-expanded="false"
                aria-label="Toggle navigation">

            <span class="navbar-toggler-icon"></span>

        </button>


        <div class="collapse navbar-collapse" id="mainNav">

            <ul class="navbar-nav ms-auto align-items-lg-center">


                @* =================================================
                   HOME
                   ================================================= *@

                <li class="nav-item">

                    <a class="nav-link"
                       asp-area=""
                       asp-controller="Home"
                       asp-action="Index">

                        @Localizer["Home"]

                    </a>

                </li>


                @* =================================================
                   ABOUT
                   ================================================= *@

                <li class="nav-item">

                    <a class="nav-link"
                       asp-area=""
                       asp-controller="About"
                       asp-action="Index">

                        @Localizer["About"]

                    </a>

                </li>


                @* =================================================
                   MESSAGES
                   ================================================= *@

                <li class="nav-item">

                    <a class="nav-link"
                       asp-area=""
                       asp-controller="Messages"
                       asp-action="Index">

                        @Localizer["Messages"]

                    </a>

                </li>


                @* =================================================
                   CONNECT DROPDOWN
                   ================================================= *@

                <li class="nav-item dropdown">

                    <a class="nav-link dropdown-toggle"
                       href="#"
                       id="connectDropdown"
                       role="button"
                       data-bs-toggle="dropdown"
                       aria-expanded="false">

                        @Localizer["Connect"]

                    </a>


                    <ul class="dropdown-menu"
                        aria-labelledby="connectDropdown">

                        <li>

                            <a class="dropdown-item"
                               asp-area=""
                               asp-controller="Member"
                               asp-action="Login">

                                @Localizer["MyAccount"]

                            </a>

                        </li>


                        <li>

                            <a class="dropdown-item"
                               asp-area=""
                               asp-controller="Prayer"
                               asp-action="Index">

                                @Localizer["PrayerRequest"]

                            </a>

                        </li>


                        <li>

                            <a class="dropdown-item"
                               asp-area=""
                               asp-controller="Programs"
                               asp-action="Index">

                                @Localizer["Programs & Training"]

                            </a>

                        </li>


                        <li>

                            <a class="dropdown-item"
                               asp-area=""
                               asp-controller="Serve"
                               asp-action="Index">

                                @Localizer["Serve With Us"]

                            </a>

                        </li>


                        <li>

                            <a class="dropdown-item"
                               asp-area=""
                               asp-controller="Contact"
                               asp-action="Index">

                                @Localizer["Contact"]

                            </a>

                        </li>

                    </ul>

                </li>


                @* =================================================
                   EVENTS
                   ================================================= *@

                <li class="nav-item">

                    <a class="nav-link"
                       asp-area=""
                       asp-controller="Events"
                       asp-action="Index">

                        @Localizer["Event"]

                    </a>

                </li>


                @* =================================================
                   PUBLIC SHOP
                   ================================================= *@

                <li class="nav-item dropdown">

                    <a class="nav-link dropdown-toggle"
                       asp-area=""
                       asp-controller="Shop"
                       asp-action="Index"
                       id="shopDropdown"
                       role="button"
                       data-bs-toggle="dropdown"
                       aria-expanded="false">

                        @Localizer["Shop"]

                    </a>


                    <ul class="dropdown-menu"
                        aria-labelledby="shopDropdown">

                        <li>

                            <a class="dropdown-item"
                               asp-area=""
                               asp-controller="Shop"
                               asp-action="Category"
                               asp-route-category="Books">

                                @Localizer["BooksAndBibles"]

                            </a>

                        </li>


                        <li>

                            <a class="dropdown-item"
                               asp-area=""
                               asp-controller="Shop"
                               asp-action="Category"
                               asp-route-category="Teachings">

                                @Localizer["TeachingsAndResources"]

                            </a>

                        </li>


                        <li>

                            <a class="dropdown-item"
                               asp-area=""
                               asp-controller="Shop"
                               asp-action="Category"
                               asp-route-category="EventCollections">

                                @Localizer["EventCollections"]

                            </a>

                        </li>


                        <li>

                            <a class="dropdown-item"
                               asp-area=""
                               asp-controller="Shop"
                               asp-action="Category"
                               asp-route-category="Apparel">

                                @Localizer["Apparel"]

                            </a>

                        </li>

                    </ul>

                </li>


                @* =================================================
                   MY ACCOUNT
                   ================================================= *@

                <li class="nav-item dropdown">

                    <a class="nav-link dropdown-toggle"
                       href="#"
                       id="accountDropdown"
                       role="button"
                       data-bs-toggle="dropdown"
                       aria-expanded="false">

                        @Localizer["MyAccount"]

                    </a>


                    <ul class="dropdown-menu"
                        aria-labelledby="accountDropdown">


                        @if (User?.Identity?.IsAuthenticated == true)
                        {

                            @* =========================================
                               MEMBER DASHBOARD
                               ========================================= *@

                            <li>

                                <a class="dropdown-item"
                                   asp-area=""
                                   asp-controller="Member"
                                   asp-action="Dashboard">

                                    Dashboard

                                </a>

                            </li>


                            @* =========================================
                               ADMIN ONLY
                               ========================================= *@

                            @if (User.HasClaim(c =>
                                c.Type == "IsAdmin" &&
                                c.Value == "true"))
                            {

                                <li>

                                    <a class="dropdown-item"
                                       asp-area="Admin"
                                       asp-controller="Dashboard"
                                       asp-action="Index">

                                        Admin Dashboard

                                    </a>

                                </li>


                                <li>

                                    <a class="dropdown-item"
                                       asp-area="Admin"
                                       asp-controller="Products"
                                       asp-action="Index">

                                        @Localizer["Products"]

                                    </a>

                                </li>

                            }


                            @* =========================================
                               SIGN OUT
                               ========================================= *@

                            <li>

                                <form asp-area=""
                                      asp-controller="Member"
                                      asp-action="Logout"
                                      method="post"
                                      class="m-0 p-0">

                                    <button type="submit"
                                            class="dropdown-item">

                                        Sign out

                                    </button>

                                </form>

                            </li>

                        }
                        else
                        {

                            @* =========================================
                               USER NOT LOGGED IN
                               ========================================= *@

                            <li>

                                <a class="dropdown-item"
                                   asp-area=""
                                   asp-controller="Member"
                                   asp-action="Login">

                                    Sign in

                                </a>

                            </li>


                            <li>

                                <a class="dropdown-item"
                                   asp-area=""
                                   asp-controller="Member"
                                   asp-action="Register">

                                    Create account

                                </a>

                            </li>

                        }

                    </ul>

                </li>


                @* =================================================
                   LANGUAGE SELECTOR
                   ================================================= *@

                @{
                    var currentCulture =
                        System.Globalization.CultureInfo
                            .CurrentUICulture
                            .TwoLetterISOLanguageName;

                    var currentLanguage =
                        currentCulture == "fr" ? "FR" : "EN";

                    var returnUrl =
                        Context.Request.Path +
                        Context.Request.QueryString;
                }


                <li class="nav-item dropdown ms-lg-2">

                    <a class="nav-link dropdown-toggle"
                       href="#"
                       id="languageDropdown"
                       role="button"
                       data-bs-toggle="dropdown"
                       aria-expanded="false">

                        <span style="color:#c9a24d;">
                            ◉
                        </span>

                        @currentLanguage

                    </a>


                    <ul class="dropdown-menu dropdown-menu-end"
                        aria-labelledby="languageDropdown">

                        @* ENGLISH *@

                        <li>

                            <form asp-area=""
                                  asp-controller="Language"
                                  asp-action="SetLanguage"
                                  method="post"
                                  class="m-0">

                                @Html.AntiForgeryToken()

                                <input type="hidden"
                                       name="culture"
                                       value="en" />

                                <input type="hidden"
                                       name="returnUrl"
                                       value="@returnUrl" />

                                <button type="submit"
                                        class="dropdown-item">

                                    <span class="me-2">
                                        🇺🇸
                                    </span>

                                    English

                                    @if (currentCulture == "en")
                                    {
                                        <span class="float-end"
                                              style="color:#c9a24d;">
                                            ✓
                                        </span>
                                    }

                                </button>

                            </form>

                        </li>


                        @* FRENCH *@

                        <li>

                            <form asp-area=""
                                  asp-controller="Language"
                                  asp-action="SetLanguage"
                                  method="post"
                                  class="m-0">

                                @Html.AntiForgeryToken()

                                <input type="hidden"
                                       name="culture"
                                       value="fr" />

                                <input type="hidden"
                                       name="returnUrl"
                                       value="@returnUrl" />

                                <button type="submit"
                                        class="dropdown-item">

                                    <span class="me-2">
                                        🇫🇷
                                    </span>

                                    Français

                                    @if (currentCulture == "fr")
                                    {
                                        <span class="float-end"
                                              style="color:#c9a24d;">
                                            ✓
                                        </span>
                                    }

                                </button>

                            </form>

                        </li>

                    </ul>

                </li>


                @* =================================================
                   DONATE
                   ================================================= *@

                <li class="nav-item ms-2">

                    <a class="btn btn-outline-cta btn-sm"
                       asp-area=""
                       asp-controller="Home"
                       asp-action="Donate">

                        Donate

                    </a>

                </li>


                @* =================================================
                   WATCH NOW
                   ================================================= *@

                <li class="nav-item ms-3">

                    <a class="btn btn-cta btn-sm"
                       href="https://youtube.com/@@francissengele?si=DV-a-vbLbis8i2IN"
                       target="_blank"
                       rel="noopener noreferrer">

                        @Localizer["Watch Now"]

                    </a>

                </li>


                @* =================================================
                   FACEBOOK
                   ================================================= *@

                <li class="nav-item ms-3">

                    <a class="btn btn-cta btn-sm"
                       href="https://www.facebook.com/profile.php?id=100024839084763"
                       target="_blank"
                       rel="noopener noreferrer">

                        Facebook

                    </a>

                </li>


            </ul>

        </div>

    </div>

</nav>