@model SengeleMinistries.Models.Product
@{
	ViewData["Title"] = Model?.Title ?? "Product";
}

<section class="section section--soft">
	<div class="container-wide">
		<div class="product-detail">
			<div class="product-media">
				<img src="@Model.ImageUrl ?? "/images/placeholder-product.png"" alt="@Model.Title" style="max-width:100%; height:auto; border-radius:8px;" />
			</div>
			<div class="product-info">
				<h1>@Model.Title</h1>
				<p class="muted small">@Model.Category</p>
				<div class="product-description">@Html.Raw(Model.Description ?? string.Empty)</div>
				<p class="product-price">@String.Format("{0:C}", Model.Price)</p>
				@if (Model.StockQuantity.HasValue)
				{
					<p class="muted">Stock: @Model.StockQuantity</p>
				}
				else
				{
					<p class="muted">Stock information not available.</p>
				}

				<p class="mt-3"><a class="btn btn-outline-cta" asp-controller="Shop" asp-action="Index">Back to shop</a></p>
			</div>
		</div>
	</div>
</section>
