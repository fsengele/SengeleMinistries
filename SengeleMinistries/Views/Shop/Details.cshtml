@model SengeleMinistries.Models.Product

@{
    ViewData["Title"] = Model?.Title ?? "Product";

    // Check if this product belongs to Amazon Associates.
    bool isAmazon = Model?.ProductType == "AmazonAffiliate";

    // Check if the Amazon affiliate link is available.
    bool hasAmazonLink =
        !string.IsNullOrWhiteSpace(Model?.AffiliateUrl);

    // Allow only HTTP or HTTPS affiliate links.
    bool validAmazonLink =
        hasAmazonLink &&
        Uri.TryCreate(
            Model!.AffiliateUrl,
            UriKind.Absolute,
            out var affiliateUri) &&
        (affiliateUri.Scheme == Uri.UriSchemeHttps ||
         affiliateUri.Scheme == Uri.UriSchemeHttp) &&
        (affiliateUri.Host.Equals(
            "amazon.com",
            StringComparison.OrdinalIgnoreCase) ||
         affiliateUri.Host.EndsWith(
            ".amazon.com",
            StringComparison.OrdinalIgnoreCase) ||
         affiliateUri.Host.Equals(
            "link.amazon",
            StringComparison.OrdinalIgnoreCase));

    // Collect up to four product images.
    var productImages = new List<string>();

    if (!string.IsNullOrWhiteSpace(Model?.ImageUrl))
    {
        productImages.Add(Model.ImageUrl);
    }

    if (!string.IsNullOrWhiteSpace(Model?.ImageUrl2))
    {
        productImages.Add(Model.ImageUrl2);
    }

    if (!string.IsNullOrWhiteSpace(Model?.ImageUrl3))
    {
        productImages.Add(Model.ImageUrl3);
    }

    if (!string.IsNullOrWhiteSpace(Model?.ImageUrl4))
    {
        productImages.Add(Model.ImageUrl4);
    }

    // Unique carousel ID for this product.
    string carouselId = $"productCarousel-{Model!.ProductId}";
}

<section class="section section--soft">

    <div class="container-wide">

        <div class="product-detail">

            @* =========================================
               PRODUCT IMAGE GALLERY
               ========================================= *@

            <div class="product-media">

                @if (productImages.Count > 0)
                {
                    <div id="@carouselId"
                         class="carousel slide"
                         data-bs-ride="@(productImages.Count > 1 ? "carousel" : "false")"
                         data-bs-interval="3000"
                         data-bs-pause="hover"
                         data-bs-wrap="true">

                        @* MAIN PRODUCT IMAGES *@

                        <div class="carousel-inner"
                             style="border-radius:8px; overflow:hidden;">

                            @for (int i = 0; i < productImages.Count; i++)
                            {
                                <div class="carousel-item @(i == 0 ? "active" : "")">

                                    <img src="@productImages[i]"
                                         alt="@Model.Title - Image @(i + 1)"
                                         class="d-block w-100"
                                         style="height:400px; object-fit:contain; background:#f8f9fa;"
                                         loading="@(i == 0 ? "eager" : "lazy")" />

                                </div>
                            }

                        </div>

                        @* PREVIOUS AND NEXT BUTTONS *@

                        @if (productImages.Count > 1)
                        {
                            <button class="carousel-control-prev"
                                    type="button"
                                    data-bs-target="#@carouselId"
                                    data-bs-slide="prev"
                                    aria-label="Previous image">

                                <span class="carousel-control-prev-icon"
                                      aria-hidden="true"
                                      style="background-color:rgba(0,0,0,0.55); border-radius:50%; padding:18px;">
                                </span>

                                <span class="visually-hidden">
                                    Previous
                                </span>

                            </button>

                            <button class="carousel-control-next"
                                    type="button"
                                    data-bs-target="#@carouselId"
                                    data-bs-slide="next"
                                    aria-label="Next image">

                                <span class="carousel-control-next-icon"
                                      aria-hidden="true"
                                      style="background-color:rgba(0,0,0,0.55); border-radius:50%; padding:18px;">
                                </span>

                                <span class="visually-hidden">
                                    Next
                                </span>

                            </button>
                        }

                    </div>

                    @* CLICKABLE IMAGE THUMBNAILS *@

                    @if (productImages.Count > 1)
                    {
                        <div class="d-flex flex-wrap justify-content-center gap-2 mt-3">

                            @for (int i = 0; i < productImages.Count; i++)
                            {
                                <button type="button"
                                        class="btn p-1 border rounded product-thumbnail @(i == 0 ? "border-dark border-2" : "")"
                                        data-bs-target="#@carouselId"
                                        data-bs-slide-to="@i"
                                        aria-label="Show image @(i + 1)"
                                        aria-current="@(i == 0 ? "true" : "false")">

                                    <img src="@productImages[i]"
                                         alt="@Model.Title thumbnail @(i + 1)"
                                         style="width:70px; height:70px; object-fit:cover; border-radius:4px;"
                                         loading="lazy" />

                                </button>
                            }

                        </div>
                    }
                }
                else
                {
                    <div class="product-image-placeholder">
                        No image available
                    </div>
                }

            </div>

            @* =========================================
               PRODUCT INFORMATION
               ========================================= *@

            <div class="product-info">

                <p class="muted small">
                    @Model.Category
                </p>

                <h1>
                    @Model.Title
                </h1>

                @if (!string.IsNullOrWhiteSpace(Model.Description))
                {
                    <div class="product-description">
                        @Model.Description
                    </div>
                }

                @* =========================================
                   AMAZON AFFILIATE PRODUCT
                   ========================================= *@

                @if (isAmazon)
                {
                    <div class="mt-3">

                        <p class="muted">
                            Available on Amazon.
                            Check Amazon for the current
                            price and availability.
                        </p>

                        @if (validAmazonLink)
                        {
                            <a href="@Model.AffiliateUrl"
                               target="_blank"
                               rel="noopener noreferrer sponsored"
                               class="btn btn-dark mt-3">

                                BUY ON AMAZON

                            </a>
                        }
                        else
                        {
                            <p class="text-danger">
                                Amazon product link
                                is currently unavailable.
                            </p>
                        }

                        <p class="muted small mt-3">
                            As an Amazon Associate,
                            I earn from qualifying purchases.
                        </p>

                    </div>
                }
                else
                {
                    @* =========================================
                       SENGELE MINISTRIES PRODUCT
                       ========================================= *@

                    <p class="product-price">
                        $@Model.Price.ToString("0.00")
                    </p>

                    @* STOCK INFORMATION *@

                    @if (Model.StockQuantity.HasValue)
                    {
                        <p class="muted">
                            Stock: @Model.StockQuantity
                        </p>
                    }
                    else
                    {
                        <p class="muted">
                            Stock information not available.
                        </p>
                    }

                    @* =========================================
                       ADD TO CART
                       ========================================= *@

                    @if (!Model.StockQuantity.HasValue ||
                         Model.StockQuantity.Value > 0)
                    {
                        <form asp-controller="Cart"
                              asp-action="AddToCart"
                              method="post"
                              class="mt-4">

                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="productId"
                                   value="@Model.ProductId" />

                            <div class="mb-3">

                                <label for="quantity"
                                       class="form-label">
                                    Quantity
                                </label>

                                <input id="quantity"
                                       name="quantity"
                                       type="number"
                                       value="1"
                                       min="1"
                                       max="@(Model.StockQuantity ?? 99)"
                                       class="form-control"
                                       style="max-width:100px;" />

                            </div>

                            <button type="submit"
                                    class="btn btn-dark">
                                ADD TO CART
                            </button>

                        </form>
                    }
                    else
                    {
                        <div class="mt-4">
                            <strong>
                                Out of stock
                            </strong>
                        </div>
                    }
                }

                @* =========================================
                   NAVIGATION
                   ========================================= *@

                <div class="mt-4">

                    @if (!isAmazon)
                    {
                        <a asp-controller="Cart"
                           asp-action="Index"
                           class="btn btn-outline-dark">
                            VIEW CART
                        </a>
                    }

                    <a asp-controller="Shop"
                       asp-action="Index"
                       class="btn btn-outline-cta">
                        BACK TO SHOP
                    </a>

                </div>

            </div>

        </div>

    </div>

</section>

@* =========================================
   CAROUSEL THUMBNAIL ACTIVE STATE
   ========================================= *@

@section Scripts {

    <script>
        document.addEventListener('DOMContentLoaded', function () {

            const carouselElement =
                document.getElementById('@carouselId');

            if (!carouselElement) {
                return;
            }

            const thumbnails =
                carouselElement.parentElement.querySelectorAll(
                    '.product-thumbnail'
                );

            carouselElement.addEventListener(
                'slid.bs.carousel',
                function (event) {

                    thumbnails.forEach(function (thumbnail, index) {

                        const isActive = index === event.to;

                        thumbnail.classList.toggle(
                            'border-dark',
                            isActive
                        );

                        thumbnail.classList.toggle(
                            'border-2',
                            isActive
                        );

                        thumbnail.setAttribute(
                            'aria-current',
                            isActive ? 'true' : 'false'
                        );

                    });

                }
            );

        });
    </script>

}
