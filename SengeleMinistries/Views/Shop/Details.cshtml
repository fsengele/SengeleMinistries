
@model SengeleMinistries.Models.Product

@{
    ViewData["Title"] = Model?.Title ?? "Product";

    // Check if this product belongs to Amazon Associates.
    bool isAmazon = Model?.ProductType == "AmazonAffiliate";

    // Check if the Amazon affiliate link is available.
    bool hasAmazonLink =
        !string.IsNullOrWhiteSpace(Model?.AffiliateUrl);

    // Allow only HTTP or HTTPS affiliate links.
    bool validAmazonLink =
        hasAmazonLink &&
        Uri.TryCreate(
            Model!.AffiliateUrl,
            UriKind.Absolute,
            out var affiliateUri) &&
        (affiliateUri.Scheme == Uri.UriSchemeHttps ||
         affiliateUri.Scheme == Uri.UriSchemeHttp) &&
        (affiliateUri.Host.Equals(
            "amazon.com",
            StringComparison.OrdinalIgnoreCase) ||
         affiliateUri.Host.EndsWith(
            ".amazon.com",
            StringComparison.OrdinalIgnoreCase) ||
         affiliateUri.Host.Equals(
            "link.amazon",
            StringComparison.OrdinalIgnoreCase));
}

<section class="section section--soft">

    <div class="container-wide">

        <div class="product-detail">

            @* =========================
               PRODUCT IMAGE
               ========================= *@
            <div class="product-media">

                @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
                {
                    <img src="@Model.ImageUrl"
                         alt="@Model.Title"
                         style="max-width:100%; height:auto; border-radius:8px;" />
                }
                else
                {
                    <div class="product-image-placeholder">
                        No image available
                    </div>
                }

            </div>

            @* =========================
               PRODUCT INFORMATION
               ========================= *@
            <div class="product-info">

                <p class="muted small">
                    @Model.Category
                </p>

                <h1>
                    @Model.Title
                </h1>

                @if (!string.IsNullOrWhiteSpace(Model.Description))
                {
                    <div class="product-description">
                        @Model.Description
                    </div>
                }

                @* =========================
                   AMAZON AFFILIATE PRODUCT
                   ========================= *@
                @if (isAmazon)
                {
                    <div class="mt-3">

                        <p class="muted">
                            Available on Amazon.
                            Check Amazon for the current
                            price and availability.
                        </p>

                        @if (validAmazonLink)
                        {
                            <a href="@Model.AffiliateUrl"
                               target="_blank"
                               rel="noopener noreferrer sponsored"
                               class="btn btn-dark mt-3">

                                BUY ON AMAZON

                            </a>
                        }
                        else
                        {
                            <p class="text-danger">
                                Amazon product link
                                is currently unavailable.
                            </p>
                        }

                        <p class="muted small mt-3">
                            As an Amazon Associate,
                            I earn from qualifying purchases.
                        </p>

                    </div>
                }
                else
                {
                    @* =========================
                       SENGELE MINISTRIES PRODUCT
                       ========================= *@

                    <p class="product-price">
                        $@Model.Price.ToString("0.00")
                    </p>

                    @* STOCK INFORMATION *@
                    @if (Model.StockQuantity.HasValue)
                    {
                        <p class="muted">
                            Stock: @Model.StockQuantity
                        </p>
                    }
                    else
                    {
                        <p class="muted">
                            Stock information not available.
                        </p>
                    }

                    @* =========================
                       ADD TO CART
                       ========================= *@
                    @if (!Model.StockQuantity.HasValue ||
                         Model.StockQuantity.Value > 0)
                    {
                        <form asp-controller="Cart"
                              asp-action="AddToCart"
                              method="post"
                              class="mt-4">

                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="productId"
                                   value="@Model.ProductId" />

                            <div class="mb-3">

                                <label for="quantity"
                                       class="form-label">
                                    Quantity
                                </label>

                                <input id="quantity"
                                       name="quantity"
                                       type="number"
                                       value="1"
                                       min="1"
                                       max="@(Model.StockQuantity ?? 99)"
                                       class="form-control"
                                       style="max-width:100px;" />

                            </div>

                            <button type="submit"
                                    class="btn btn-dark">
                                ADD TO CART
                            </button>

                        </form>
                    }
                    else
                    {
                        <div class="mt-4">
                            <strong>
                                Out of stock
                            </strong>
                        </div>
                    }
                }

                @* =========================
                   NAVIGATION
                   ========================= *@
                <div class="mt-4">

                    @if (!isAmazon)
                    {
                        <a asp-controller="Cart"
                           asp-action="Index"
                           class="btn btn-outline-dark">
                            VIEW CART
                        </a>
                    }

                    <a asp-controller="Shop"
                       asp-action="Index"
                       class="btn btn-outline-cta">
                        BACK TO SHOP
                    </a>

                </div>

            </div>

        </div>

    </div>

</section>
