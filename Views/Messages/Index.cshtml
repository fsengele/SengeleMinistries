@{
	ViewData["Title"] = "Messages";
}

<section class="messages-hero hero">
	<div class="hero-inner">
		<div class="hero-grid">
			<div>
				<div class="hero-kicker">MESSAGES • SERMONS • TEACHINGS</div>
				<h1 class="hero-title">THE WORD. FAITH. HOPE.</h1>
				<p class="hero-sub">Explore transformative messages from Pastor Francis Sengele — a library of teaching rooted in prayer and the Word.</p>
				<p class="mt-3"><a class="btn btn-cta" href="https://youtube.com/@@francissengele?si=DV-a-vbLbis8i2IN" target="_blank" rel="noopener noreferrer">▶ WATCH LATEST MESSAGE</a></p>
			</div>
			<div class="message-visual">
				<div class="message-media" style="background-image:url('/images/TUEQ6134.JPG')" aria-hidden="true"></div>
			</div>
		</div>
	</div>
</section>

<section class="section section--soft">
	<div class="container-wide">
		<div class="eyebrow">FEATURED</div>
		<div class="message-card message-card--feature mt-2">
			<div class="message-info">
				<div class="label-small">LATEST</div>
				<h2 class="message-title">Watch the most recent message</h2>
				<p class="message-excerpt muted">If you'd like to engage with teaching grounded in hope and prayer, start with the latest featured message.</p>
				<p class="mt-3"><a class="btn btn-cta" href="https://youtube.com/@@francissengele?si=DV-a-vbLbis8i2IN" target="_blank">▶ WATCH MESSAGE</a></p>
			</div>
			<div class="message-media" style="background-image:url('/images/IMG_7497.JPG')" aria-hidden="true"></div>
		</div>
	</div>
</section>

<section class="section section--dark messages-core">
	<div class="container-wide text-center">
		<h2 class="core-heading">HOPE • PRAYER • THE WORD</h2>
		<p class="muted core-sub">Des messages pour fortifier la foi, restaurer l'espérance et conduire chacun plus près de Dieu.</p>
	</div>
</section>

<section class="section section--white messages-cta">
	<div class="container-wide text-center">
		<div class="eyebrow">CONTINUEZ À ÉCOUTER</div>
		<h2 class="lead-heading">PLUS DE MESSAGES. PLUS D'ENSEIGNEMENTS.</h2>
		<p class="muted">Retrouvez nos prédications, enseignements et nouveaux messages sur notre chaîne YouTube.</p>
		<p class="mt-3"><a class="btn btn-cta" href="https://youtube.com/@@francissengele?si=DV-a-vbLbis8i2IN" target="_blank" rel="noopener noreferrer">▶ REGARDER SUR YOUTUBE</a></p>
	</div>
</section>
