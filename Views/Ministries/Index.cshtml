@{
	ViewData["Title"] = "Ministries";
}

<section class="section section--dark ministries-hero">
	<div class="container-wide text-center">
		<div class="eyebrow">MINISTRIES</div>
		<h1 class="hero-heading">WE EXIST FOR PEOPLE</h1>
		<p class="hero-sub muted">Service • Prayer • Teaching • Evangelism • Community</p>
		<div class="gold-line" aria-hidden="true" style="margin-top:24px;"></div>
	</div>
</section>

<main>
	<section class="section section--soft">
		<div class="container-wide">
			<div class="ministries-list">
				<article class="ministry-item">
					<div class="ministry-meta">
						<div class="ministry-number">01</div>
						<div class="ministry-label">PRAYER CARE</div>
					</div>
					<div class="ministry-body">
						<h3>Compassionate intercession</h3>
						<p class="muted">A dedicated team prays for personal needs and urgent situations. Confidential and faithful prayer support is available for everyone who asks.</p>
					</div>
				</article>

				<article class="ministry-item alt">
					<div class="ministry-meta">
						<div class="ministry-number">02</div>
						<div class="ministry-label">COMMUNITY OUTREACH</div>
					</div>
					<div class="ministry-body">
						<h3>Serving our neighborhoods</h3>
						<p class="muted">Programs focused on care, practical support and building strong local communities in the spirit of Christ's love.</p>
					</div>
				</article>

				<article class="ministry-item">
					<div class="ministry-meta">
						<div class="ministry-number">03</div>
						<div class="ministry-label">TEACHING &amp; DISCIPLESHIP</div>
					</div>
					<div class="ministry-body">
						<h3>Rooted in the Word</h3>
						<p class="muted">Bible study groups, seminary-level teaching and life-applicable training designed to strengthen faith and practice.</p>
					</div>
				</article>

			</div>
		</div>
	</section>
</main>